 docs/chat-item-labels.md                           |  5 +++--
 tests/e2e_ui/chat/test_item_label_chips.py         |  9 ++++++---
 .../components/chat/SessionItemsButton.test.tsx    | 14 +++++++++++++-
 web/src/components/chat/SessionItemsButton.tsx     |  6 ++++++
 4 files changed, 28 insertions(+), 6 deletions(-)

