From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Desidero <desidero@gmail.com>
Date: Mon, 19 Oct 2026 20:04:41 +0000
Subject: [PATCH] fix(claude-native): settle a mirrored sub-agent when its
 parent records the result

A mirrored Claude sub-agent that is killed mid-tool never writes a turn
end. The forwarder then keeps it running until its mid-turn idle window
runs out (600 seconds), although the parent already holds the child's
result.

When the parent records a child's result, the server now settles a child
that is still running or waiting: idle for a completed result, failed for
a failed one. Retried results are skipped so a resumed child is not cut
short.

This is what remains of the earlier "keep quiet sub-agents running until
their turn ends" patch. Upstream fixed the forwarder half in
https://github.com/omnigent-ai/omnigent/pull/13811 (the forwarder tracks
whether the child's turn is still open), so that half is dropped.

Not upstream yet: not proposed by us; the open upstream PR
https://github.com/omnigent-ai/omnigent/pull/12411 (not ours) also touches
this code. Drop this copy once upstream settles a returned child itself.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Signed-off-by: Desidero <desidero@gmail.com>
Docs: none (fix: a returned sub-agent stops showing as working; no setting)
---
 omnigent/server/subagent_activity.py          | 19 +++++++++++++++++++
 tests/server/routes/test_subagent_activity.py | 11 +++++++++++
 2 files changed, 30 insertions(+)

diff --git a/omnigent/server/subagent_activity.py b/omnigent/server/subagent_activity.py
index 53f3d5e3d3ab6da159776f722ff03a9573dc7789..6514d0e0e2ff096c69d0608b89478750072ec30c 100644
--- a/omnigent/server/subagent_activity.py
+++ b/omnigent/server/subagent_activity.py
@@ -317,6 +317,22 @@ def claude_subagent_completion_markers(
     ]
 
 
+def _settle_returned_claude_child_status(child_id: str, status: str) -> None:
+    """End a mirrored child's Working state once its parent holds the result.
+
+    The forwarder reports idle only when the child's transcript shows its turn
+    ended, which a child killed mid-tool never writes.
+    """
+    from omnigent.server.routes._sessions.helpers import _publish_status, _session_status_cache
+
+    if _session_status_cache.get(child_id) not in ("running", "waiting"):
+        return
+    if status == "failed":
+        _publish_status(child_id, "failed", failure_origin="claude_subagent_result")
+    else:
+        _publish_status(child_id, "idle")
+
+
 async def _record_claude_subagent_return(
     parent_id: str,
     item: NewConversationItem | ConversationItem,
@@ -347,6 +363,9 @@ async def _record_claude_subagent_return(
                     turn_id=child.labels.get("omnigent.claude_native.tool_use_id") or child.id,
                     status=status,
                 )
+                # A retried result may predate a resumed run of the same child.
+                if not (isinstance(item, ConversationItem) and item.deduplicated):
+                    _settle_returned_claude_child_status(child.id, status)
         if not page.has_more or page.last_id is None:
             return
         after = page.last_id
diff --git a/tests/server/routes/test_subagent_activity.py b/tests/server/routes/test_subagent_activity.py
index 6761e76b78c63c74b227663ab95c4e684752513e..69c73858690ec6f56174b70835044cb412953382 100644
--- a/tests/server/routes/test_subagent_activity.py
+++ b/tests/server/routes/test_subagent_activity.py
@@ -7,6 +7,7 @@ import pytest
 from sqlalchemy import event
 
 from omnigent.entities import MessageData, NewConversationItem
+from omnigent.server.routes._sessions.helpers import _session_status_cache
 from omnigent.server.routes._sessions.orchestration import (
     _persist_external_conversation_item,
     _persist_external_conversation_items,
@@ -124,6 +125,7 @@ def _message(text: str) -> dict[str, Any]:
 @pytest.mark.asyncio
 async def test_claude_completion_survives_retries_and_late_child_discovery(
     db_uri: str,
+    monkeypatch: pytest.MonkeyPatch,
     data: dict[str, Any],
     return_id: str | None,
     expected: str | None,
@@ -149,6 +151,10 @@ async def test_claude_completion_survives_retries_and_late_child_discovery(
         return child.id
 
     child_id = None if late else await register_child()
+    publish_status = Mock()
+    monkeypatch.setattr("omnigent.server.routes._sessions.helpers._publish_status", publish_status)
+    if child_id is not None:
+        monkeypatch.setitem(_session_status_cache, child_id, "running")
     item_type = "function_call_output" if "call_id" in data else "message"
     body = SessionEventInput(
         type="external_conversation_item",
@@ -184,6 +190,11 @@ async def test_claude_completion_survives_retries_and_late_child_discovery(
         assert store.list_items(parent.id).data == []
     for _ in range(2):
         await deliver()
+    # A live result ends a running child's turn once; a retry or late child does not.
+    settled = {"completed": "idle", "failed": "failed"}.get(expected or "")
+    assert [call.args for call in publish_status.call_args_list] == (
+        [(child_id, settled)] if settled and not late else []
+    )
     [persisted] = store.list_items(parent.id, type=item_type).data
     assert persisted.data.subagent_return_id == return_id
     if late:
