From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Desidero <desidero@gmail.com>
Date: Tue, 27 Oct 2026 04:16:27 +0000
Subject: [PATCH] fix(web): bring the toast safe-area fix up to its PR

Build the Toaster's top and bottom offsets in toasterOffsets() next to
updateOverlayToastOffset(), with unit tests, so the safe-area offsets match
https://github.com/omnigent-ai/omnigent/pull/11390.

Signed-off-by: Desidero <desidero@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Docs: none (layout fix: the toast offsets move into a tested helper; nothing to configure)
---
 web/src/lib/updateOverlayInset.test.ts | 12 +++++++++++-
 web/src/lib/updateOverlayInset.ts      |  9 +++++++++
 web/src/shell/AppShell.tsx             | 15 +++------------
 3 files changed, 23 insertions(+), 13 deletions(-)

diff --git a/web/src/lib/updateOverlayInset.test.ts b/web/src/lib/updateOverlayInset.test.ts
index cb8c4578e739639ceb97b579b9d84f23a51b0744..957e78c66f9c2f4ccbde88c6e2da3ac366183def 100644
--- a/web/src/lib/updateOverlayInset.test.ts
+++ b/web/src/lib/updateOverlayInset.test.ts
@@ -1,5 +1,5 @@
 import { describe, expect, it } from "vitest";
-import { updateOverlayToastOffset } from "./updateOverlayInset";
+import { toasterOffsets, updateOverlayToastOffset } from "./updateOverlayInset";
 
 describe("updateOverlayToastOffset", () => {
   it("uses only the normal safe-area offset while the overlay is hidden", () => {
@@ -17,3 +17,13 @@ describe("updateOverlayToastOffset", () => {
     expect(updateOverlayToastOffset(-20)).toContain("+ 0px");
   });
 });
+
+describe("toasterOffsets", () => {
+  it("keeps top toasts below the native status bar inset", () => {
+    const { offset, mobileOffset } = toasterOffsets(0);
+    expect(offset.top).toBe("calc(24px + var(--omnigent-inset-top))");
+    expect(mobileOffset.top).toBe("calc(16px + var(--omnigent-inset-top))");
+    expect(offset.bottom).toBe(updateOverlayToastOffset(0));
+    expect(mobileOffset.bottom).toBe(updateOverlayToastOffset(0));
+  });
+});
diff --git a/web/src/lib/updateOverlayInset.ts b/web/src/lib/updateOverlayInset.ts
index 617011ca1cd1c664efef170da633903abd7b07f1..65eb3ff5801310755b1ace9226370615ace01437 100644
--- a/web/src/lib/updateOverlayInset.ts
+++ b/web/src/lib/updateOverlayInset.ts
@@ -3,3 +3,12 @@ export function updateOverlayToastOffset(height: number): string {
   const overlayInset = normalized > 0 ? normalized + 12 : 0;
   return `calc(1rem + var(--omnigent-inset-bottom) + ${overlayInset}px)`;
 }
+
+/** Toaster offsets: top clears the native status bar / Dynamic Island, bottom the update overlay. */
+export function toasterOffsets(updateOverlayHeight: number) {
+  const bottom = updateOverlayToastOffset(updateOverlayHeight);
+  return {
+    offset: { top: "calc(24px + var(--omnigent-inset-top))", right: "1rem", bottom },
+    mobileOffset: { top: "calc(16px + var(--omnigent-inset-top))", right: "1rem", bottom },
+  };
+}
diff --git a/web/src/shell/AppShell.tsx b/web/src/shell/AppShell.tsx
index 729782522e6a18255c32a8c9a7ae257ad3584c21..7da2f0f6e773614e0c86a656673f768ce542e01d 100644
--- a/web/src/shell/AppShell.tsx
+++ b/web/src/shell/AppShell.tsx
@@ -70,7 +70,7 @@ import {
   writeDefaultWorkspacePanelOpen,
 } from "@/lib/workspacePanelPreferences";
 import { readTranscriptViewDefault } from "@/lib/transcriptViewPreferences";
-import { updateOverlayToastOffset } from "@/lib/updateOverlayInset";
+import { toasterOffsets } from "@/lib/updateOverlayInset";
 import {
   type DefaultWorkspaceTab,
   isDefaultWorkspaceTab,
@@ -2920,17 +2920,8 @@ function AppShellImpl() {
           <Toaster
             position="top-center"
             visibleToasts={100}
-            // Top toasts start below the iOS status bar / Dynamic Island.
-            offset={{
-              top: "calc(24px + var(--omnigent-inset-top))",
-              right: "1rem",
-              bottom: updateOverlayToastOffset(updateOverlayHeight),
-            }}
-            mobileOffset={{
-              top: "calc(16px + var(--omnigent-inset-top))",
-              right: "1rem",
-              bottom: updateOverlayToastOffset(updateOverlayHeight),
-            }}
+            // Keep top toasts below the native status bar / Dynamic Island.
+            {...toasterOffsets(updateOverlayHeight)}
           />
         </ForkDialogContextProvider>
       </TerminalFirstContextProvider>
