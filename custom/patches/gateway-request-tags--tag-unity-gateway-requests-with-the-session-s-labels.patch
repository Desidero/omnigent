+def _clear_ci_tags(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("OMNIGENT_CI_CONTEXT", raising=False)
+    monkeypatch.delenv("OMNIGENT_CI_PIPELINE", raising=False)
+
+
+def test_gateway_request_tags_send_the_session_id_and_user_labels_only(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from omnigent.databricks_ai_gateway import gateway_request_tags_value
+
+    _clear_ci_tags(monkeypatch)
+    labels = {
+        "team": "ml",
+        "project": "chat bot",
+        "omnigent.wrapper": "claude-code-native-ui",
+        "omni_project": "sidebar",
+        "cost_control.plan": "{}",
+        # A label cannot replace the session id.
+        "omnigent_session_id": "spoofed",
+    }
+
+    assert gateway_request_tags_value("conv_abc123", labels) == (
+        '{"omnigent_session_id":"conv_abc123","project":"chat bot","team":"ml"}'
+    )
+
+
+def test_gateway_request_tags_drop_labels_past_the_cap_but_keep_the_session_id(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from omnigent.databricks_ai_gateway import gateway_request_tags, gateway_request_tags_value
+
+    _clear_ci_tags(monkeypatch)
+    labels = {"a": "x" * 3000, "b": "y" * 3000, "c": "small", "d\n": "é"}
+
+    tags = gateway_request_tags("conv_1", labels)
+
+    assert list(tags) == ["omnigent_session_id", "a", "c", "d\n"]
+    encoded = gateway_request_tags_value("conv_1", labels)
+    assert encoded is not None and encoded.isascii() and "\n" not in encoded
+    assert len(encoded) <= 4096
+    assert gateway_request_tags("conv_1", {"a": "x" * 5000}) == {"omnigent_session_id": "conv_1"}
+
+
+def test_gateway_request_tags_carry_ci_tags_ahead_of_labels(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from omnigent.databricks_ai_gateway import gateway_request_tags
+
+    _clear_ci_tags(monkeypatch)
+    monkeypatch.setenv("OMNIGENT_CI_PIPELINE", "review")
+
+    tags = gateway_request_tags("conv_1", {"pipeline": "label", "team": "ml"})
+
+    assert tags == {"omnigent_session_id": "conv_1", "pipeline": "review", "team": "ml"}
