diff --git a/web/src/components/composer/ComposerPrWatch.test.tsx b/web/src/components/composer/ComposerPrWatch.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..57713ca0d630223c4f24f24a605a562f7211567f
--- /dev/null
+++ b/web/src/components/composer/ComposerPrWatch.test.tsx
@@ -0,0 +1,206 @@
+// The composer's "Watch PRs" control against the real watch hooks, with fetch
+// stubbed as a small in-memory server and the PR panel data mocked.
+
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import type { PullRequestWatchStatus } from "@/hooks/usePullRequestWatch";
+import type * as UsePullRequestsModule from "@/hooks/usePullRequests";
+import { FALLBACK_SERVER_INFO } from "@/lib/capabilities";
+import { CapabilitiesProvider } from "@/lib/CapabilitiesContext";
+import { ComposerPrWatch, prWatchLabel } from "./ComposerPrWatch";
+
+const PR_7 = "https://github.com/acme/app/pull/7";
+const PR_9 = "https://github.com/acme/app/pull/9";
+const PR_5 = "https://github.com/acme/app/pull/5";
+const WATCH_PATH = "/v1/sessions/conv_1/pr-watch";
+
+const state = vi.hoisted(() => ({
+  canEdit: true,
+  offline: false,
+  tracked: [] as string[],
+  details: {} as Record<string, { state: string; failing: number; title: string }>,
+}));
+
+vi.mock("@/hooks/usePermissions", () => ({ useCanEdit: () => state.canEdit }));
+vi.mock("@/hooks/usePullRequests", async (importOriginal) => ({
+  ...(await importOriginal<typeof UsePullRequestsModule>()),
+  usePullRequestInfo: (_conversationId: string, options?: { prUrl?: string }) => {
+    if (state.offline) return { data: undefined, isError: true };
+    const prUrl = options?.prUrl;
+    if (!prUrl) {
+      return {
+        data: {
+          object: "session.github.info",
+          available: true,
+          tracking_available: true,
+          prs: state.tracked.map((url) => ({
+            url,
+            host: "github.com",
+            repository: "acme/app",
+            number: Number(url.split("/").pop()),
+            title: state.details[url]?.title,
+            relationship: "created",
+          })),
+        },
+        isError: false,
+      };
+    }
+    const detail = state.details[prUrl];
+    return {
+      data: {
+        object: "session.github.info",
+        available: true,
+        pr: {
+          url: prUrl,
+          number: Number(prUrl.split("/").pop()),
+          title: detail.title,
+          state: detail.state,
+          checks: { passing: 0, failing: detail.failing, pending: 0, total: 1, runs: [] },
+        },
+      },
+      isError: false,
+    };
+  },
+}));
+
+let server: PullRequestWatchStatus;
+let calls: string[];
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status });
+}
+
+function entry(prUrl: string) {
+  return { pr_url: prUrl, watching: true, ended: null, wakes: 1, max_wakes: 10, started_at: 1 };
+}
+
+beforeEach(() => {
+  state.canEdit = true;
+  state.offline = false;
+  state.tracked = [PR_7, PR_9, PR_5];
+  state.details = {
+    [PR_7]: { state: "OPEN", failing: 2, title: "Fix the parser" },
+    [PR_9]: { state: "OPEN", failing: 0, title: "Add docs" },
+    [PR_5]: { state: "MERGED", failing: 0, title: "Old work" },
+  };
+  server = { object: "session.pr_watch", mode: "off", active: false, max_wakes: 10, prs: [] };
+  calls = [];
+  vi.stubGlobal(
+    "fetch",
+    vi.fn((input: RequestInfo | URL, init?: RequestInit) => {
+      const url = new URL(String(input), "http://localhost");
+      if (url.pathname !== WATCH_PATH) return Promise.resolve(json({}, 404));
+      const method = init?.method ?? "GET";
+      const body = init?.body ? JSON.parse(String(init.body)) : null;
+      calls.push(body ? `${method} ${JSON.stringify(body)}` : method);
+      if (method === "PUT") {
+        // As after the next poll: open PRs enrolled, the merged one noted as ended.
+        const merged = { ...entry(PR_5), watching: false, ended: "merged" as const };
+        server = { ...server, mode: "all", active: true, prs: [entry(PR_7), entry(PR_9), merged] };
+      } else if (method === "PATCH" && body.watch) {
+        server = { ...server, mode: "selected", active: true, prs: [entry(body.pr_url)] };
+      } else if (method === "PATCH") {
+        const prs = server.prs.filter((pr) => pr.pr_url !== body.pr_url);
+        server = { ...server, mode: prs.length ? "selected" : "off", active: !!prs.length, prs };
+      } else if (method === "DELETE") {
+        server = { ...server, mode: "off", active: false, prs: [] };
+      }
+      return Promise.resolve(json(server));
+    }),
+  );
+});
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+function renderControl(enabled = true) {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={client}>
+      <CapabilitiesProvider
+        info={{ ...FALLBACK_SERVER_INFO, features: enabled ? { pr_watch: true } : {} }}
+      >
+        <ComposerPrWatch conversationId="conv_1" />
+      </CapabilitiesProvider>
+    </QueryClientProvider>,
+  );
+}
+
+async function openPopover() {
+  fireEvent.click(await screen.findByTestId("composer-pr-watch"));
+  return screen.findByTestId("composer-pr-watch-popover");
+}
+
+it("renders nothing and asks nothing while the feature is off", () => {
+  const { container } = renderControl(false);
+  expect(container).toBeEmptyDOMElement();
+  expect(calls).toEqual([]);
+});
+
+it("watches every PR, then drops one and keeps the rest", async () => {
+  renderControl();
+  expect(await screen.findByTestId("composer-pr-watch")).toHaveTextContent("Watch PRs");
+  const popover = await openPopover();
+
+  // Open PRs only, each with its CI state.
+  const rows = within(popover).getAllByTestId("pr-watch-row");
+  expect(rows.map((row) => row.textContent)).toEqual([
+    expect.stringContaining("#7Fix the parser2 failing"),
+    expect.stringContaining("#9Add docspassing"),
+  ]);
+  expect(popover).toHaveTextContent("comments from collaborators; stops when green");
+
+  fireEvent.click(within(popover).getByTestId("pr-watch-all"));
+  await waitFor(() =>
+    expect(screen.getByTestId("composer-pr-watch")).toHaveTextContent("Watching 2 PRs"),
+  );
+  expect(within(popover).getByTestId("pr-watch-all")).toHaveAttribute("aria-checked", "true");
+  const boxes = within(popover).getAllByRole("checkbox", { name: /Watch #/ });
+  expect(boxes.map((box) => box.getAttribute("aria-checked"))).toEqual(["true", "true"]);
+  expect(popover).toHaveTextContent("1/10 wake-ups");
+
+  fireEvent.click(within(popover).getByRole("checkbox", { name: "Watch #9" }));
+  await waitFor(() =>
+    expect(screen.getByTestId("composer-pr-watch")).toHaveTextContent("Watching 1 PR"),
+  );
+  expect(within(popover).getByTestId("pr-watch-all")).toHaveAttribute("aria-checked", "false");
+  expect(calls).toEqual(["GET", 'PUT {"mode":"all"}', `PATCH {"pr_url":"${PR_9}","watch":false}`]);
+});
+
+it("watches one PR on its own", async () => {
+  renderControl();
+  const popover = await openPopover();
+  fireEvent.click(within(popover).getByRole("checkbox", { name: "Watch #7" }));
+  await waitFor(() =>
+    expect(screen.getByTestId("composer-pr-watch")).toHaveTextContent("Watching 1 PR"),
+  );
+  expect(calls).toContain(`PATCH {"pr_url":"${PR_7}","watch":true}`);
+});
+
+it.each([
+  ["a viewer", () => (state.canEdit = false), "Only people who can edit this session"],
+  ["an offline host", () => (state.offline = true), "host is offline"],
+])("is disabled with a reason for %s", async (_name, arrange, reason) => {
+  arrange();
+  renderControl();
+  const popover = await openPopover();
+  expect(within(popover).getByTestId("pr-watch-all")).toBeDisabled();
+  expect(within(popover).getByRole("note")).toHaveTextContent(reason);
+});
+
+it("labels the chip from the watched PRs", () => {
+  const status: PullRequestWatchStatus = {
+    object: "session.pr_watch",
+    mode: "all",
+    active: true,
+    max_wakes: 10,
+    prs: [{ ...entry(PR_9), watching: false, ended: "green" }],
+  };
+  expect(prWatchLabel(undefined, [PR_7])).toBe("Watch PRs");
+  expect(prWatchLabel(status, [])).toBe("Watching new PRs");
+  expect(prWatchLabel(status, [PR_7, PR_9])).toBe("Watching 1 PR");
+  expect(prWatchLabel({ ...status, mode: "off", active: false }, [PR_7])).toBe("Watch PRs");
+});
diff --git a/web/src/components/composer/ComposerPrWatch.tsx b/web/src/components/composer/ComposerPrWatch.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..74cabeb56c660201312da5582df6b42b6ee47097
--- /dev/null
+++ b/web/src/components/composer/ComposerPrWatch.tsx
@@ -0,0 +1,243 @@
+/**
+ * "Watch PRs" chip for the composer workspace bar: which of the session's pull
+ * requests the server keeps on until they're green. Its popover has an "All
+ * PRs" box (every PR now and any the session opens later) and one box per open
+ * PR. Renders nothing unless the server enables the `pr_watch` feature.
+ */
+import { useId, useState } from "react";
+import { EyeIcon, Loader2Icon } from "lucide-react";
+
+import { Button } from "@/components/ui/button";
+import { Checkbox } from "@/components/ui/checkbox";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { useCanEdit } from "@/hooks/usePermissions";
+import {
+  type PullRequestWatchEnd,
+  type PullRequestWatchStatus,
+  isPullRequestWatched,
+  pullRequestWatchEntry,
+  usePullRequestWatch,
+  usePullRequestWatchAvailable,
+  useSetPullRequestWatch,
+} from "@/hooks/usePullRequestWatch";
+import {
+  type PullRequestAssociation,
+  type PullRequestChecks,
+  usePullRequestInfo,
+} from "@/hooks/usePullRequests";
+import { cn } from "@/lib/utils";
+
+export const PR_WATCH_HINT =
+  "Wakes the agent on failed checks, merge conflicts and comments from collaborators; " +
+  "stops when green.";
+
+const ENDED_LABELS: Record<PullRequestWatchEnd, string> = {
+  green: "Stopped: green",
+  merged: "Stopped: merged",
+  closed: "Stopped: closed",
+  checks_unreadable: "Stopped: checks unreadable",
+  budget: "Stopped: wake-ups used up",
+  undeliverable: "Stopped: couldn't wake the agent",
+};
+
+/** The chip's text: what is watched, or the call to action. */
+export function prWatchLabel(status: PullRequestWatchStatus | undefined, prUrls: string[]): string {
+  if (!status?.active) return "Watch PRs";
+  const count = prUrls.filter((url) => isPullRequestWatched(status, url)).length;
+  if (count === 0) return status.mode === "all" ? "Watching new PRs" : "Watch PRs";
+  return `Watching ${count} PR${count === 1 ? "" : "s"}`;
+}
+
+function ChecksBadge({ checks }: { checks: PullRequestChecks }) {
+  const [label, tone] =
+    checks.failing > 0
+      ? [`${checks.failing} failing`, "border-destructive/40 text-destructive"]
+      : checks.pending > 0
+        ? ["running", "border-amber-500/40 text-amber-600 dark:text-amber-400"]
+        : checks.total > 0
+          ? ["passing", "border-emerald-500/40 text-emerald-600 dark:text-emerald-400"]
+          : ["no checks", "border-border text-muted-foreground"];
+  return (
+    <span
+      data-testid="pr-watch-checks"
+      className={cn("shrink-0 rounded-full border px-1.5 text-xs tabular-nums", tone)}
+    >
+      {label}
+    </span>
+  );
+}
+
+/** One tracked PR. Its details load when the popover opens; closed PRs drop out. */
+function WatchRow({
+  conversationId,
+  pr,
+  status,
+  disabled,
+  onChange,
+}: {
+  conversationId: string;
+  pr: PullRequestAssociation;
+  status: PullRequestWatchStatus | undefined;
+  disabled: boolean;
+  onChange: (watch: boolean) => void;
+}) {
+  const id = useId();
+  const info = usePullRequestInfo(conversationId, { prUrl: pr.url }).data?.pr;
+  if (info && info.url === pr.url && info.state !== "OPEN") return null;
+  const entry = pullRequestWatchEntry(status, pr.url);
+  const watched = isPullRequestWatched(status, pr.url);
+  const detail = entry?.ended
+    ? ENDED_LABELS[entry.ended]
+    : entry?.watching
+      ? `${entry.wakes}/${entry.max_wakes} wake-ups`
+      : null;
+  return (
+    <li className="flex items-start gap-2 px-1 py-1.5" data-testid="pr-watch-row">
+      <Checkbox
+        id={id}
+        checked={watched}
+        disabled={disabled}
+        onCheckedChange={(checked) => onChange(checked === true)}
+        componentId="composer.pr_watch.pr"
+        className="mt-0.5"
+        aria-label={`Watch #${pr.number}`}
+      />
+      <label htmlFor={id} className="flex min-w-0 flex-1 flex-col gap-0.5">
+        <span className="flex min-w-0 items-center gap-1.5">
+          <span className="shrink-0 tabular-nums text-muted-foreground">#{pr.number}</span>
+          <span className="truncate" title={pr.title ?? info?.title ?? pr.url}>
+            {pr.title ?? info?.title ?? pr.repository}
+          </span>
+        </span>
+        {detail && <span className="text-xs text-muted-foreground">{detail}</span>}
+      </label>
+      {info?.url === pr.url ? (
+        <ChecksBadge checks={info.checks} />
+      ) : (
+        <Loader2Icon
+          className="mt-0.5 size-3.5 shrink-0 animate-spin text-muted-foreground"
+          aria-label="Loading checks"
+        />
+      )}
+    </li>
+  );
+}
+
+export function ComposerPrWatch({ conversationId }: { conversationId: string | null }) {
+  const available = usePullRequestWatchAvailable(conversationId);
+  if (!available || !conversationId) return null;
+  return <ComposerPrWatchControl conversationId={conversationId} />;
+}
+
+function ComposerPrWatchControl({ conversationId }: { conversationId: string }) {
+  const [open, setOpen] = useState(false);
+  const allId = useId();
+  const canEdit = useCanEdit(conversationId);
+  const github = usePullRequestInfo(conversationId);
+  const status = usePullRequestWatch(conversationId);
+  const setWatch = useSetPullRequestWatch(conversationId);
+  const prs = github.data?.tracking_available ? (github.data.prs ?? []) : [];
+  const unavailable = github.isError
+    ? "Pull requests can't be read while the session's host is offline."
+    : github.data && !github.data.tracking_available
+      ? "This session's host can't track pull requests."
+      : null;
+  // Show nothing until the session's PR state is known; a non-repo has nothing to watch.
+  if (!status.data || (!github.data && !github.isError)) return null;
+  if (github.data && !github.data.available) return null;
+
+  const watchStatus = status.data;
+  const label = prWatchLabel(
+    watchStatus,
+    prs.map((pr) => pr.url),
+  );
+  const disabledReason = !canEdit
+    ? "Only people who can edit this session can change what it watches."
+    : unavailable;
+  const busy = setWatch.isPending;
+
+  return (
+    <Popover open={open} onOpenChange={setOpen}>
+      <PopoverTrigger asChild>
+        <Button
+          type="button"
+          variant="ghost"
+          size="xs"
+          data-testid="composer-pr-watch"
+          aria-label={label}
+          className={cn(
+            "shrink-0 gap-1 px-1 font-normal text-muted-foreground md:px-2",
+            watchStatus.active && "text-foreground",
+          )}
+        >
+          <EyeIcon
+            className={cn("size-3.5", watchStatus.active && "text-primary")}
+            strokeWidth={1.5}
+            aria-hidden="true"
+          />
+          {label}
+        </Button>
+      </PopoverTrigger>
+      <PopoverContent
+        side="top"
+        align="start"
+        collisionPadding={8}
+        aria-label="Watch pull requests"
+        data-testid="composer-pr-watch-popover"
+        className="max-h-[min(28rem,var(--radix-popover-content-available-height))] w-[min(24rem,calc(100vw-2rem))] gap-2 overflow-y-auto"
+      >
+        <div className="flex flex-col gap-0.5 px-1">
+          <span className="font-medium">Watch pull requests until green</span>
+          <span className="text-xs text-muted-foreground">
+            {PR_WATCH_HINT} Up to {watchStatus.max_wakes} wake-ups per PR.
+          </span>
+        </div>
+        <div className="flex items-start gap-2 rounded-md bg-muted/50 px-1 py-1.5">
+          <Checkbox
+            id={allId}
+            checked={watchStatus.mode === "all"}
+            disabled={!!disabledReason || busy}
+            onCheckedChange={(checked) => setWatch.mutate({ kind: "all", watch: checked === true })}
+            componentId="composer.pr_watch.all"
+            data-testid="pr-watch-all"
+            className="mt-0.5"
+          />
+          <label htmlFor={allId} className="flex flex-col gap-0.5">
+            <span>All PRs in this session</span>
+            <span className="text-xs text-muted-foreground">Including any it opens later.</span>
+          </label>
+        </div>
+        {prs.length > 0 ? (
+          <ul className="flex flex-col divide-y divide-border">
+            {prs.map((pr) => (
+              <WatchRow
+                key={pr.url}
+                conversationId={conversationId}
+                pr={pr}
+                status={watchStatus}
+                disabled={!!disabledReason || busy}
+                onChange={(watch) => setWatch.mutate({ kind: "pr", prUrl: pr.url, watch })}
+              />
+            ))}
+          </ul>
+        ) : (
+          !unavailable && (
+            <p className="px-1 text-xs text-muted-foreground">
+              No pull requests yet. With All on, the first one the session opens is watched.
+            </p>
+          )
+        )}
+        {disabledReason && (
+          <p role="note" className="px-1 text-xs text-muted-foreground">
+            {disabledReason}
+          </p>
+        )}
+        {setWatch.error && (
+          <p role="alert" className="px-1 text-xs text-destructive">
+            {setWatch.error.message}
+          </p>
+        )}
+      </PopoverContent>
+    </Popover>
+  );
+}
diff --git a/web/src/hooks/usePullRequestWatch.ts b/web/src/hooks/usePullRequestWatch.ts
