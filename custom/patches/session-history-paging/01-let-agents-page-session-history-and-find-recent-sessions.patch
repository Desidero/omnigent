+def _api_message(item_id: str, text: str) -> dict[str, object]:
+    """Build one API-shaped assistant message item."""
+    return {
+        "id": item_id,
+        "type": "message",
+        "role": "assistant",
+        "content": [{"type": "output_text", "text": text}],
+    }
+
