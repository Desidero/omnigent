@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+import {
+  extractInlineRunnableCommand,
+  extractRunnableCommands,
+  harnessRunsShellCommands,
+  MAX_RUNNABLE_COMMANDS,
+} from "./runnableCommands";
+
+describe("extractRunnableCommands", () => {
+  it("splits each !-prefixed line into its own command", () => {
+    const code = "! gcloud auth login\n!gh auth status\n";
+    expect(extractRunnableCommands(code, undefined)).toEqual([
+      "gcloud auth login",
+      "gh auth status",
+    ]);
+  });
+
+  it("ignores commentary lines around ! commands, in any language", () => {
+    const code = "# first log in\n! gcloud auth login\nthen retry";
+    expect(extractRunnableCommands(code, "text")).toEqual(["gcloud auth login"]);
+  });
+
+  it("does not treat !! or a bare ! as a command", () => {
+    expect(extractRunnableCommands("!!\n!\n", "bash")).toEqual([]);
+  });
+
+  it("joins backslash continuations into one command", () => {
+    const code = "! docker run \\\n  --rm alpine";
+    expect(extractRunnableCommands(code, undefined)).toEqual(["docker run --rm alpine"]);
+  });
+
+  it("yields one command per line of a shell block, skipping comments", () => {
+    const code = "# install\nnpm install\n\nnpm test\n";
+    expect(extractRunnableCommands(code, "bash")).toEqual(["npm install", "npm test"]);
+    expect(extractRunnableCommands(code, "Shell")).toEqual(["npm install", "npm test"]);
+  });
+
+  it("keeps only prompted lines of a console transcript", () => {
+    const code = "$ git status\nOn branch main\n$ git log -1\n";
+    expect(extractRunnableCommands(code, "console")).toEqual(["git status", "git log -1"]);
+  });
+
+  it("offers nothing for non-shell blocks without ! lines", () => {
+    expect(extractRunnableCommands("print('hi')", "python")).toEqual([]);
+    expect(extractRunnableCommands("npm install", undefined)).toEqual([]);
+  });
+
+  it("offers nothing for a heredoc, which line splitting would break", () => {
+    expect(extractRunnableCommands("cat <<EOF > a.txt\nhi\nEOF", "bash")).toEqual([]);
+  });
+
+  it("offers nothing for a block longer than the command cap", () => {
+    const code = Array.from({ length: MAX_RUNNABLE_COMMANDS + 1 }, (_, i) => `!echo ${i}`).join(
+      "\n",
+    );
+    expect(extractRunnableCommands(code, undefined)).toEqual([]);
+  });
+});
+
+describe("extractInlineRunnableCommand", () => {
+  it("reads a ! inline span", () => {
+    expect(extractInlineRunnableCommand("! gcloud auth login")).toBe("gcloud auth login");
+    expect(extractInlineRunnableCommand("!ls")).toBe("ls");
+  });
+
+  it("rejects plain inline code", () => {
+    expect(extractInlineRunnableCommand("git status")).toBeNull();
+    expect(extractInlineRunnableCommand("!!")).toBeNull();
+  });
+});
+
+describe("harnessRunsShellCommands", () => {
+  it("allows only harnesses with a shell input mode", () => {
+    expect(harnessRunsShellCommands("claude-native")).toBe(true);
+    expect(harnessRunsShellCommands("codex-native")).toBe(true);
+    expect(harnessRunsShellCommands("claude-sdk")).toBe(false);
+    expect(harnessRunsShellCommands(null)).toBe(false);
+  });
+});
diff --git a/web/src/lib/runnableCommands.ts b/web/src/lib/runnableCommands.ts
new file mode 100644
index 0000000000000000000000000000000000000000..edf73abd8b759f2a25e89fd6b2a00bd9f4d21469
--- /dev/null
+++ b/web/src/lib/runnableCommands.ts
@@ -0,0 +1,90 @@
+/**
+ * Detect shell commands an agent asks the user to run, so the chat can offer a
+ * one-tap "Run" that queues each as a `!command` shell input.
+ */
+
+/** Harnesses whose web composer treats a `!command` message as a shell input. */
+const SHELL_INPUT_HARNESSES = new Set(["claude-native", "codex-native"]);
+
+/** Fence languages whose whole body is commands, even without `!` prefixes. */
+const SHELL_LANGUAGES = new Set(["bash", "sh", "shell", "zsh", "console", "shell-session"]);
+
+/** More commands than this reads as a script to study, not steps to run. */
+export const MAX_RUNNABLE_COMMANDS = 10;
+
+const PROMPT_PREFIX = /^\$\s+/;
+
+/**
+ * Whether a session's harness runs a `!command` message as a shell input.
+ *
+ * @param harness - The session harness id, e.g. `"claude-native"`.
+ */
+export function harnessRunsShellCommands(harness: string | null | undefined): boolean {
+  return harness != null && SHELL_INPUT_HARNESSES.has(harness);
+}
+
+/** The command after a single leading `!`, or null when `line` is not one. */
+function bangCommand(line: string): string | null {
+  const trimmed = line.trim();
+  if (!trimmed.startsWith("!") || trimmed.startsWith("!!")) return null;
+  const command = trimmed.slice(1).trim();
+  return command === "" ? null : command;
+}
+
+/** Split code into logical lines, joining trailing-backslash continuations. */
+function logicalLines(code: string): string[] {
+  const lines: string[] = [];
+  let pending = "";
+  for (const line of code.split(/\r?\n/)) {
+    const piece = pending === "" ? line : line.trimStart();
+    if (/\\\s*$/.test(piece)) {
+      pending += `${piece.replace(/\\\s*$/, "").trimEnd()} `;
+      continue;
+    }
+    lines.push(pending + piece);
+    pending = "";
+  }
+  if (pending !== "") lines.push(pending);
+  return lines;
+}
+
+/**
+ * Commands a fenced code block asks the user to run, one per queued input.
+ *
+ * `!`-prefixed lines win: each becomes its own command and other lines are
+ * treated as commentary. Otherwise a shell-language block yields one command
+ * per line, keeping only `$ `-prompted lines when it shows a transcript.
+ * Heredocs and long scripts yield nothing, since splitting them would change
+ * what runs.
+ *
+ * @param code - The code block body.
+ * @param language - The fence language, e.g. `"bash"`, if any.
+ * @returns The commands without their `!` prefix, e.g. `["gcloud auth login"]`.
+ */
+export function extractRunnableCommands(code: string, language?: string | null): string[] {
+  const lines = logicalLines(code);
+  const bangCommands = lines.map(bangCommand).filter((command) => command !== null);
+  if (bangCommands.length > 0) {
+    return bangCommands.length <= MAX_RUNNABLE_COMMANDS ? bangCommands : [];
+  }
+
+  if (!language || !SHELL_LANGUAGES.has(language.toLowerCase())) return [];
+  if (code.includes("<<")) return [];
+
+  const nonBlank = lines.map((line) => line.trim()).filter((line) => line !== "");
+  const hasPrompts = nonBlank.some((line) => PROMPT_PREFIX.test(line));
+  const commands = nonBlank
+    .filter((line) => (hasPrompts ? PROMPT_PREFIX.test(line) : !/^[#!]/.test(line)))
+    .map((line) => line.replace(PROMPT_PREFIX, "").trim())
+    .filter((line) => line !== "");
+  return commands.length <= MAX_RUNNABLE_COMMANDS ? commands : [];
+}
+
+/**
+ * The command in an inline code span written as `` `! cmd` ``, or null.
+ *
+ * @param text - The inline code text, e.g. `"! gcloud auth login"`.
+ */
+export function extractInlineRunnableCommand(text: string): string | null {
+  return text.includes("\n") ? null : bangCommand(text);
+}
