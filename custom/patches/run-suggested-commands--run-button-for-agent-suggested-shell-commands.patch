+    asyncio.run(run())
+
+    assert [payload["data"] for payload in posted] == [
+        {
+            "item_type": "terminal_command",
+            "item_data": {"kind": "input", "input": "gcloud auth list"},
+            "response_id": "codex_turn_123",
+            "source_id": "thread_123:turn_123:shell_1:input",
