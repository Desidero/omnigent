@@ -0,0 +1,89 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { FilePathAwareMessageResponse } from "@/components/blocks/ChatMarkdown";
+import { RunCommandsProvider } from "./RunCommandsProvider";
+
+beforeEach(() => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => new Response("{}", { status: 404 })),
+  );
+});
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+function renderAgentText(
+  markdown: string,
+  { onRun = vi.fn(), allowRunCommands = true } = {},
+): (commands: string[]) => void {
+  render(
+    <QueryClientProvider client={new QueryClient()}>
+      <RunCommandsProvider onRun={onRun}>
+        <FilePathAwareMessageResponse allowRunCommands={allowRunCommands} mode="static">
+          {markdown}
+        </FilePathAwareMessageResponse>
+      </RunCommandsProvider>
+    </QueryClientProvider>,
+  );
+  return onRun;
+}
+
+describe("RunCommandsProvider", () => {
+  it("confirms a block's ! commands and runs them in order", async () => {
+    const onRun = renderAgentText("Please run:\n\n```\n! gcloud auth login\n!gh auth status\n```");
+
+    fireEvent.click(await screen.findByRole("button", { name: "Run 2 commands" }));
+    const dialog = await screen.findByRole("dialog", { name: "Run 2 commands?" });
+    expect(within(dialog).getByText("!gcloud auth login")).toBeInTheDocument();
+    expect(within(dialog).getByText("!gh auth status")).toBeInTheDocument();
+    expect(onRun).not.toHaveBeenCalled();
+
+    fireEvent.click(within(dialog).getByRole("button", { name: "Run" }));
+    expect(onRun).toHaveBeenCalledExactlyOnceWith(["gcloud auth login", "gh auth status"]);
+  });
+
+  it("runs nothing when the confirmation is cancelled", async () => {
+    const onRun = renderAgentText("```\n!make\n```");
+
+    fireEvent.click(await screen.findByRole("button", { name: "Run command" }));
+    fireEvent.click(await screen.findByRole("button", { name: "Cancel" }));
+    expect(onRun).not.toHaveBeenCalled();
+  });
+
+  it("reads the fence language to offer a plain bash block", async () => {
+    renderAgentText("```bash\nnpm install\nnpm test\n```");
+    expect(await screen.findByRole("button", { name: "Run 2 commands" })).toBeInTheDocument();
+  });
+
+  it("offers an inline ! span", async () => {
+    const onRun = renderAgentText("Run `! gh auth login` and tell me when done.");
+
+    fireEvent.click(await screen.findByRole("button", { name: "Run command" }));
+    fireEvent.click(within(await screen.findByRole("dialog")).getByRole("button", { name: "Run" }));
+    expect(onRun).toHaveBeenCalledExactlyOnceWith(["gh auth login"]);
+  });
+
+  it("hides Run where the text does not opt in", async () => {
+    renderAgentText("```\n!make\n```\n\n`!ls`", { allowRunCommands: false });
+    await screen.findByRole("button", { name: "Copy Code" });
+    expect(screen.queryByRole("button", { name: /^Run/ })).not.toBeInTheDocument();
+  });
+
+  it("hides Run when the session cannot run shell inputs", async () => {
+    render(
+      <QueryClientProvider client={new QueryClient()}>
+        <RunCommandsProvider onRun={null}>
+          <FilePathAwareMessageResponse allowRunCommands mode="static">
+            {"```\n!make\n```"}
+          </FilePathAwareMessageResponse>
+        </RunCommandsProvider>
+      </QueryClientProvider>,
+    );
+    await screen.findByRole("button", { name: "Copy Code" });
+    expect(screen.queryByRole("button", { name: /^Run/ })).not.toBeInTheDocument();
+  });
+});
diff --git a/web/src/components/chat/RunCommandsProvider.tsx b/web/src/components/chat/RunCommandsProvider.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5e1b76d2bbe1c5285ca92734fdefbcc61e785003
--- /dev/null
+++ b/web/src/components/chat/RunCommandsProvider.tsx
@@ -0,0 +1,85 @@
+import type { ReactNode } from "react";
+import { useCallback, useMemo, useState } from "react";
+import { RunCommandsContext } from "@/components/ai-elements/message";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+
+/**
+ * Lets agent messages offer Run on suggested shell commands, confirming the
+ * exact list before handing it to `onRun`. A null `onRun` hides every Run
+ * control, e.g. for a harness without a shell input mode.
+ */
+export function RunCommandsProvider({
+  onRun,
+  children,
+}: {
+  onRun: ((commands: string[]) => void) | null;
+  children: ReactNode;
+}) {
+  const [pendingCommands, setPendingCommands] = useState<string[] | null>(null);
+  const requestRun = useMemo(
+    () => (onRun ? (commands: string[]) => setPendingCommands(commands) : null),
+    [onRun],
+  );
+  const confirm = useCallback(() => {
+    if (onRun && pendingCommands) onRun(pendingCommands);
+    setPendingCommands(null);
+  }, [onRun, pendingCommands]);
+
+  // Each row keeps its position: the same command may repeat in one block.
+  const rows = useMemo(
+    () =>
+      (pendingCommands ?? []).map((command, position) => ({
+        id: `${position}:${command}`,
+        command,
+      })),
+    [pendingCommands],
+  );
+  const count = rows.length;
+  return (
+    <RunCommandsContext.Provider value={requestRun}>
+      {children}
+      <Dialog
+        open={pendingCommands !== null}
+        onOpenChange={(open) => {
+          if (!open) setPendingCommands(null);
+        }}
+      >
+        <DialogContent className="sm:max-w-lg">
+          <DialogHeader>
+            <DialogTitle>
+              {count === 1 ? "Run this command?" : `Run ${count} commands?`}
+            </DialogTitle>
+            <DialogDescription>
+              {count === 1
+                ? "It runs on the session's host as a shell input."
+                : "Each runs on the session's host as its own shell input, in this order."}
+            </DialogDescription>
+          </DialogHeader>
+          <ol className="flex max-h-64 flex-col gap-1.5 overflow-y-auto">
+            {rows.map(({ id, command }) => (
+              <li key={id}>
+                <pre className="whitespace-pre-wrap break-all rounded-md bg-muted px-2.5 py-1.5 font-mono text-xs">
+                  !{command}
+                </pre>
+              </li>
+            ))}
+          </ol>
+          <DialogFooter>
+            <Button variant="outline" onClick={() => setPendingCommands(null)}>
+              Cancel
+            </Button>
+            <Button onClick={confirm}>Run</Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </RunCommandsContext.Provider>
+  );
+}
