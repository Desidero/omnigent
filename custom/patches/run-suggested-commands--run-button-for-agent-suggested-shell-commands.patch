+        "status": "inProgress",
+    }
+    completed_item = {
+        **started_item,
+        "status": "completed",
+        "aggregatedOutput": "No credentialed accounts.\n",
+        "exitCode": 1,
+    }
+
+    def event(method: str, **params: Any) -> dict[str, Any]:
+        return {
+            "method": method,
+            "params": {"threadId": "thread_123", "turnId": "turn_123", **params},
+        }
+
+    events = (
