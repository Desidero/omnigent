+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { SUBAGENT_ROUTING_LABEL_KEY } from "@/components/CostRoutingControl";
+import { DropdownMenu, DropdownMenuContent } from "@/components/ui/dropdown-menu";
+import { CapabilitiesProvider } from "@/lib/CapabilitiesContext";
+import { FALLBACK_SERVER_INFO } from "@/lib/capabilities";
+import type { Session } from "@/lib/types";
+import { useChatStore } from "@/store/chatStore";
+import { SubagentRoutingItem } from "./SubagentRoutingItem";
+
+const sessionRead = vi.hoisted(() => ({ session: null as unknown, reads: 0 }));
+vi.mock("@/hooks/useSession", () => ({
+  useSession: () => {
+    sessionRead.reads += 1;
+    return { session: sessionRead.session, isLoading: false, error: null };
+  },
+}));
+
+const initialState = useChatStore.getState();
+
+afterEach(() => {
+  cleanup();
+  useChatStore.setState(initialState, true);
+  sessionRead.session = null;
+  sessionRead.reads = 0;
+});
+
+const ROUTING_SERVER = { ...FALLBACK_SERVER_INFO, smart_routing_enabled: true };
+
+function nativeSession(labels: Record<string, string> = {}): Partial<Session> {
+  return { agentName: "claude-native-ui", parentSessionId: null, harness: "claude-native", labels };
+}
+
+function renderItem({
+  session,
+  override = null,
+  info = ROUTING_SERVER,
+  onChange = () => {},
+}: {
+  session: Partial<Session> | null;
+  override?: "on" | "off" | null;
+  info?: typeof FALLBACK_SERVER_INFO;
+  onChange?: (mode: "on" | "off") => void;
+}) {
+  sessionRead.session = session;
+  useChatStore.setState({ conversationId: "conv_1", subagentRoutingOverride: override });
+  return render(
+    <CapabilitiesProvider info={info}>
+      <DropdownMenu open>
+        <DropdownMenuContent>
+          <SubagentRoutingItem
+            sessionId={undefined}
+            conversationId="conv_1"
+            disabled={false}
+            onChange={onChange}
+          />
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </CapabilitiesProvider>,
+  );
+}
+
+const item = () => screen.queryByTestId("composer-agent-subagent-routing");
+
+it("toggles sub-agent routing on a native session created with it", () => {
+  const onChange = vi.fn();
+  renderItem({
+    session: nativeSession({ [SUBAGENT_ROUTING_LABEL_KEY]: "1" }),
+    override: "on",
+    onChange,
+  });
+
+  expect(item()?.getAttribute("aria-checked")).toBe("true");
+  expect(item()?.getAttribute("data-subagent-routing-reach")).toBe("spawns");
+  expect(item()?.textContent).toBe("Route sub-agents");
+  fireEvent.click(item()!);
+  expect(onChange).toHaveBeenCalledWith("off");
+});
+
+it("keeps the control after the switch is turned off, so it can come back on", () => {
+  const onChange = vi.fn();
+  renderItem({
+    session: nativeSession({ [SUBAGENT_ROUTING_LABEL_KEY]: "1" }),
+    override: "off",
+    onChange,
+  });
+
+  expect(item()?.getAttribute("aria-checked")).toBe("false");
+  fireEvent.click(item()!);
+  expect(onChange).toHaveBeenCalledWith("on");
+});
+
+it("says so when only child sessions are routed", () => {
+  // A plain native launch has no spawn gate; the switch was turned on later.
+  renderItem({ session: nativeSession(), override: "on" });
+
+  expect(item()?.getAttribute("data-subagent-routing-reach")).toBe("child-sessions");
+  expect(item()?.textContent).toContain("Child sessions only");
+});
+
+it("offers nothing on a plain native session", () => {
+  renderItem({ session: nativeSession(), override: null });
+  expect(item()).toBeNull();
+});
+
+it("reads no session on a server that cannot route", () => {
+  renderItem({
+    session: nativeSession({ [SUBAGENT_ROUTING_LABEL_KEY]: "1" }),
+    override: "on",
+    info: FALLBACK_SERVER_INFO,
+  });
+  expect(item()).toBeNull();
+  expect(sessionRead.reads).toBe(0);
+});
diff --git a/web/src/components/composer/SubagentRoutingItem.tsx b/web/src/components/composer/SubagentRoutingItem.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4f9c3a7e7fcad1e5b831499c3ffde7f929c46bcd
--- /dev/null
+++ b/web/src/components/composer/SubagentRoutingItem.tsx
@@ -0,0 +1,74 @@
+import { NetworkIcon } from "lucide-react";
+import { subagentRoutingReach } from "@/components/CostRoutingControl";
+import { useSessionField } from "@/components/composer/sessionPickerInputs";
+import { DropdownMenuCheckboxItem, DropdownMenuSeparator } from "@/components/ui/dropdown-menu";
+import { useSession } from "@/hooks/useSession";
+import { SUBAGENT_ROUTING_LABEL } from "@/lib/agentLabels";
+import { useServerInfo } from "@/lib/CapabilitiesContext";
+
+interface SubagentRoutingItemProps {
+  /** Read and change this session instead of the active conversation. */
+  sessionId: string | undefined;
+  /** The conversation the picker is showing, or `null` before one exists. */
+  conversationId: string | null;
+  disabled: boolean;
+  /** Persist the switch; the picker runs it under its busy guard. */
+  onChange: (mode: "on" | "off") => void;
+}
+
+/**
+ * The session picker's "Route sub-agents" row: Smart Routing picks the model
+ * of each sub-agent the session starts while the session keeps its own.
+ * Renders nothing on a server that cannot route or a session with no control.
+ */
+export function SubagentRoutingItem(props: SubagentRoutingItemProps) {
+  const serverInfo = useServerInfo();
+  if (serverInfo === "loading" || !serverInfo.smart_routing_enabled) return null;
+  if (props.conversationId === null) return null;
+  return <RoutableSubagentRoutingItem {...props} conversationId={props.conversationId} />;
+}
+
+function RoutableSubagentRoutingItem({
+  sessionId,
+  conversationId,
+  disabled,
+  onChange,
+}: SubagentRoutingItemProps & { conversationId: string }) {
+  const { session } = useSession(conversationId);
+  const override = useSessionField(sessionId, (state) => state.subagentRoutingOverride);
+  // The store holds the live switch; the snapshot's can trail a toggle.
+  const costControlModeOverride = useSessionField(
+    sessionId,
+    (state) => state.costControlModeOverride,
+  );
+  const reach =
+    session === null
+      ? null
+      : subagentRoutingReach({ ...session, costControlModeOverride }, override);
+  if (reach === null) return null;
+  return (
+    <>
+      <DropdownMenuCheckboxItem
+        checked={override === "on"}
+        disabled={disabled}
+        onCheckedChange={(checked) => onChange(checked ? "on" : "off")}
+        onSelect={(event) => event.preventDefault()}
+        className="items-start"
+        data-testid="composer-agent-subagent-routing"
+        data-subagent-routing-reach={reach}
+      >
+        <NetworkIcon className="mt-0.5 size-4" aria-hidden="true" />
+        <span className="flex min-w-0 flex-col">
+          <span>{SUBAGENT_ROUTING_LABEL}</span>
+          {reach === "child-sessions" && (
+            <span className="text-xs whitespace-normal text-muted-foreground">
+              Child sessions only. This session started without sub-agent routing, so its built-in
+              sub-agents keep their own model.
+            </span>
+          )}
+        </span>
+      </DropdownMenuCheckboxItem>
+      <DropdownMenuSeparator />
+    </>
+  );
+}
