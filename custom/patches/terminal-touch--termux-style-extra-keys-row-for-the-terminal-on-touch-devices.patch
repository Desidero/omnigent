+      ["Ctrl", "Alt", "Shift", "←", "↓", "→", "PgDn"],
+    ]);
+    const modifiers = EXTRA_KEY_ROWS.flat().filter((k) => k.kind === "modifier");
+    expect(modifiers.map((k) => k.id)).toEqual(["ctrl", "alt", "shift"]);
+  });
