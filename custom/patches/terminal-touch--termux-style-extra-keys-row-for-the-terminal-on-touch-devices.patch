+    expect(encodeExtraKey("tab", mods({ shift: true }), normal)).toBe("\x1b[Z");
+    expect(encodeExtraKey("tab", mods({ alt: true }), normal)).toBe("\x1b\t");
+    expect(encodeExtraKey("tab", mods({ ctrl: true }), normal)).toBe("\t");
+  });
