From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Desidero <desidero@gmail.com>
Date: Mon, 19 Oct 2026 20:04:41 +0000
Subject: [PATCH] fix(claude-native): register in-process teammates as child
 sessions

Claude Code agent-team teammates run inside the lead's process and write
agent-<id>.meta.json with taskKind "in_process_teammate" and no toolUseId.
The forwarder required a toolUseId, so teammates were never registered:
they were missing from the Agents rail, their transcripts were not
mirrored or counted in the parent's real-time cost estimate, and each
unregistered meta kept the forwarder re-reading every transcript on
every poll.

Register a teammate under the lead session without spawn correlation,
lead its description with the teammate's name (the handle the lead
messages it by), and send a stable "teammate:<id>" tool-use id, which
the existing server accepts unchanged. Read metas before correlating so
a poll with only teammate or unreadable metas skips the transcript scan.

Not upstream yet: proposed from fix/claude-native-teammate-children; drop this copy once it merges.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Desidero <desidero@gmail.com>
Docs: none (fix: agent-team teammates appear as child sessions like other sub-agents; no setting)
---
 omnigent/harnesses/claude_native/forwarder.py | 43 +++++++---
 .../forwarder/test_subagent_discovery.py      | 79 +++++++++++++++++++
 2 files changed, 111 insertions(+), 11 deletions(-)

diff --git a/omnigent/harnesses/claude_native/forwarder.py b/omnigent/harnesses/claude_native/forwarder.py
index e8d3d28da3618379050b913356c1c89ae22703a2..24dc6144db24d09c1b9ac9c5bbc3e231b5ddf3f8 100644
--- a/omnigent/harnesses/claude_native/forwarder.py
+++ b/omnigent/harnesses/claude_native/forwarder.py
@@ -129,9 +129,12 @@ _MAX_SEEN_DELTA_KEYS = 5000
 _SUBAGENT_IDLE_THRESHOLD_S = 5.0
 
 # Meta-file glob inside ``~/.claude/projects/<encoded>/<session>/subagents/``.
-# One per Claude Task-tool subagent; appears alongside the matching
-# ``agent-<id>.jsonl`` transcript.
+# One per Claude Task-tool subagent or in-process teammate; appears alongside
+# the matching ``agent-<id>.jsonl`` transcript.
 _SUBAGENT_META_GLOB = "agent-*.meta.json"
+# ``taskKind`` of an agent-team teammate running inside the lead's process. No
+# tool call spawns it, so its meta has no ``toolUseId``.
+_IN_PROCESS_TEAMMATE_TASK_KIND = "in_process_teammate"
 # Claude's built-in sub-agent spawn tool; its tool-use id is the ``toolUseId``
 # stamped into each ``agent-<id>.meta.json``. Reuse the router's canonical set so
 # both the current ``Agent`` name and the still-supported ``Task`` alias match.
@@ -1944,10 +1947,14 @@ def _read_subagent_meta(meta_path: Path) -> dict[str, str] | None:
     or malformed so the watcher can skip it gracefully and try again
     on the next tick.
 
+    An in-process teammate has no ``toolUseId``; it is returned with an
+    empty one, and its ``name`` (the handle the lead messages it by) leads
+    the description.
+
     :param meta_path: Path to ``agent-<id>.meta.json``.
     :returns: A dict with string-typed ``agentType``, ``description``,
-        and ``toolUseId``; or ``None`` when the file is missing /
-        malformed / missing any required key.
+        and ``toolUseId`` (empty for a teammate); or ``None`` when the
+        file is missing / malformed / missing any required key.
     """
     try:
         raw = json.loads(meta_path.read_text(encoding="utf-8"))
@@ -1963,7 +1970,12 @@ def _read_subagent_meta(meta_path: Path) -> dict[str, str] | None:
     if not isinstance(description, str):
         return None
     if not isinstance(tool_use_id, str) or not tool_use_id:
-        return None
+        if raw.get("taskKind") != _IN_PROCESS_TEAMMATE_TASK_KIND:
+            return None
+        tool_use_id = ""
+        name = raw.get("name")
+        if isinstance(name, str) and name.strip():
+            description = f"{name.strip()}: {description}" if description else name.strip()
     return {
         "agentType": agent_type,
         "description": description,
@@ -2665,7 +2677,7 @@ def _subagent_own_spawn_tool_use_id(agent_jsonl_path: Path) -> str | None:
         agent_jsonl_path.name.removesuffix(".jsonl") + ".meta.json"
     )
     meta = _read_subagent_meta(meta_path)
-    return meta["toolUseId"] if meta is not None else None
+    return (meta["toolUseId"] or None) if meta is not None else None
 
 
 def _subagent_parents_by_tool_use(
@@ -2781,21 +2793,30 @@ async def _forward_available_subagents(
         if (sid := _subagent_id_from_meta_path(path)) not in updated.subagents
         and start_retry_tracker.retry_delay_s(f"subagent_start:{sid}") is None
     ]
+    candidate_metas: list[tuple[Path, dict[str, str]]] = []
+    for meta_path in candidate_meta_paths:
+        meta = await asyncio.to_thread(_read_subagent_meta, meta_path)
+        if meta is not None:
+            candidate_metas.append((meta_path, meta))
     parents_by_tool_use = (
         await asyncio.to_thread(
             _subagent_parents_by_tool_use,
             transcript_path,
             subagents_dir,
         )
-        if candidate_meta_paths
+        if any(meta["toolUseId"] for _, meta in candidate_metas)
         else {}
     )
     pending: list[tuple[Path, dict[str, str], str | None]] = []
-    for meta_path in candidate_meta_paths:
-        meta = await asyncio.to_thread(_read_subagent_meta, meta_path)
-        if meta is None:
-            continue
+    for meta_path, meta in candidate_metas:
         tool_use_id = meta["toolUseId"]
+        if not tool_use_id:
+            # An in-process teammate belongs to the team lead (this session). The
+            # server requires a tool-use id, so stand in a stable one that no real
+            # spawn record can match.
+            subagent_id = _subagent_id_from_meta_path(meta_path)
+            pending.append((meta_path, {**meta, "toolUseId": f"teammate:{subagent_id}"}, None))
+            continue
         if tool_use_id not in parents_by_tool_use:
             # No transcript owns this spawn yet: the record is still mid-write, or
             # it resolved to two owners and was dropped as ambiguous. Either way we
diff --git a/tests/harnesses/claude_native/forwarder/test_subagent_discovery.py b/tests/harnesses/claude_native/forwarder/test_subagent_discovery.py
index f438ba0a22a6712b36d2b360265c2e733657738f..c0aec2a89c4b81d0a3f8800831871e3f437c43c0 100644
--- a/tests/harnesses/claude_native/forwarder/test_subagent_discovery.py
+++ b/tests/harnesses/claude_native/forwarder/test_subagent_discovery.py
@@ -102,6 +102,85 @@ async def test_subagent_watcher_registers_a_task_named_spawn(
     assert state.subagents["a-worker"].parent_subagent_id is None
 
 
+async def test_subagent_watcher_registers_an_in_process_teammate_under_the_lead(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """An agent-team teammate has no spawn tool call, so it attaches to the lead.
+
+    Its meta carries ``taskKind: "in_process_teammate"`` and no ``toolUseId``.
+    Registration must not wait on spawn correlation, and a meta missing
+    ``toolUseId`` for any other reason stays unregistered.
+    """
+    bridge_dir = tmp_path / "bridge"
+    transcript_path = tmp_path / "session.jsonl"
+    transcript_path.write_text("", encoding="utf-8")
+    subagents_dir = transcript_path.parent / transcript_path.stem / "subagents"
+    subagents_dir.mkdir(parents=True)
+    metas = {
+        "teammate": {
+            "agentType": "differ",
+            "description": "Version-diff pass on findings",
+            "name": "differ",
+            "taskKind": "in_process_teammate",
+            "teamName": "session-c13bb742",
+        },
+        "malformed": {"agentType": "Explore", "description": "no spawn id"},
+    }
+    for subagent_id, meta in metas.items():
+        (subagents_dir / f"agent-{subagent_id}.meta.json").write_text(
+            json.dumps(meta), encoding="utf-8"
+        )
+        (subagents_dir / f"agent-{subagent_id}.jsonl").write_text("", encoding="utf-8")
+
+    def fail_correlation(*_args: Any) -> dict[str, str | None]:
+        raise AssertionError("a teammate alone must not trigger a transcript scan")
+
+    monkeypatch.setattr(forwarder, "_subagent_parents_by_tool_use", fail_correlation)
+    starts: list[tuple[str, dict[str, Any]]] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        body = json.loads(request.content)
+        if body.get("type") != "external_subagent_start":
+            return httpx.Response(202, json={})
+        starts.append((request.url.path, body["data"]))
+        return httpx.Response(
+            202,
+            json={"queued": False, "child_session_id": f"conv_{body['data']['subagent_id']}"},
+        )
+
+    async with httpx.AsyncClient(
+        transport=httpx.MockTransport(handler),
+        base_url="http://ap",
+    ) as client:
+        state = await forwarder._forward_available_subagents(
+            client=client,
+            parent_session_id="conv_root",
+            bridge_dir=bridge_dir,
+            transcript_path=transcript_path,
+            state=forwarder.SubagentForwardState(subagents={}),
+            agent_name="claude-native-ui",
+            start_retry_tracker=forwarder._PostRetryTracker(base_delay_s=0.0),
+            item_retry_tracker=forwarder._PostRetryTracker(base_delay_s=0.0),
+            status_retry_tracker=forwarder._PostRetryTracker(base_delay_s=0.0),
+        )
+
+    assert starts == [
+        (
+            "/v1/sessions/conv_root/events",
+            {
+                "subagent_id": "teammate",
+                "agent_type": "differ",
+                "description": "differ: Version-diff pass on findings",
+                "tool_use_id": "teammate:teammate",
+            },
+        )
+    ]
+    assert state.subagents["teammate"].child_conversation_id == "conv_teammate"
+    assert state.subagents["teammate"].parent_subagent_id is None
+    assert "malformed" not in state.subagents
+
+
 async def test_subagent_watcher_posts_external_subagent_start_for_new_meta(
     tmp_path: Path,
 ) -> None:
