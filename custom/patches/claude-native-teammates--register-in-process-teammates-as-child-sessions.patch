     record_hook_event(
         bridge_dir,
         {
@@ -677,7 +907,13 @@ async def test_subagent_watcher_skips_subagents_already_in_state(
                         "byte_offset": 0,
                         "last_activity_ts": None,
                         "last_status": None,
-                    }
