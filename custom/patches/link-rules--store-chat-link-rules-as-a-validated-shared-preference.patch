+from omnigent.link_rules import (
+    DEFAULT_LINK_RULES,
+    GIT_PROVIDERS,
+    MAX_REPEAT,
+    LinkRule,
+    LinkRuleError,
+    LinkRuleKind,
+    check_git_host,
+    check_url_template,
