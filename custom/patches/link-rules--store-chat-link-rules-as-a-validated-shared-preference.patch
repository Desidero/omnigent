+        ),
+        ([{"name": "GH", "kind": "github", "host": "ghe.example.com"}], "old github kind"),
+    ],
+)
+def test_rule_lists_are_validated(rules, message):
+    with pytest.raises(LinkRuleError, match=re.escape(message)):
+        validate_link_rules(rules)
+
