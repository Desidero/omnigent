+  if (composingLabel !== null && composingCloses) closing.add(composingLabel);
+  if (closing.size > 0) parts.push(`closes ${[...closing].join(", ")}`);
   return [plural(labels.length, "comment"), ...parts].join(" · ");
 }
 
