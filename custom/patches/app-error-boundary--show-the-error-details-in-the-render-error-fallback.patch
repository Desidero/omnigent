From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mhavant <matthew.hoelting@avant.com>
Date: Fri, 23 Oct 2026 22:36:07 -0500
Subject: [PATCH] fix(web): show the error details in the render error fallback

When rendering crashes, upstream's RenderErrorBoundary (around the routes,
the pull requests panel and the mobile drawers) shows only "Unable to
display <name>." with Try again. That leaves nothing to report: the error
is logged to the browser console only, which phones and the desktop app
don't expose.

Keep upstream's boundary and its Try again, and add to its fallback the
error (message and stack), the component stack and the path, in a
scrollable selectable block, plus Copy details and a full Reload.

This replaces the separate app-wide AppErrorBoundary this series carried
before upstream added RenderErrorBoundary.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mhavant <matthew.hoelting@avant.com>
Signed-off-by: Desidero <desidero@gmail.com>
Docs: none (error screen shown only when the web app crashes while rendering; no setting)
---
 .../components/RenderErrorBoundary.test.tsx   | 30 ++++++++++++-
 web/src/components/RenderErrorBoundary.tsx    | 45 +++++++++++++++++--
 2 files changed, 70 insertions(+), 5 deletions(-)

diff --git a/web/src/components/RenderErrorBoundary.test.tsx b/web/src/components/RenderErrorBoundary.test.tsx
index 3a8c165b5983d0cf6dbfb3f20c2a61b77b5a8ab1..da676f11752f1f6c729a6d04d5ad8ba5f924088b 100644
--- a/web/src/components/RenderErrorBoundary.test.tsx
+++ b/web/src/components/RenderErrorBoundary.test.tsx
@@ -4,6 +4,9 @@ import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
 import { ChunkLoadErrorBoundary } from "./ChunkLoadErrorBoundary";
 import { RenderErrorBoundary } from "./RenderErrorBoundary";
 
+const { copyText } = vi.hoisted(() => ({ copyText: vi.fn(async () => {}) }));
+vi.mock("@/lib/clipboard", () => ({ copyText }));
+
 const renderError = new Error("Component render failed");
 const chunkError = new TypeError("Failed to fetch dynamically imported module: /assets/old.js");
 const reload = vi.fn();
@@ -16,7 +19,8 @@ beforeEach(() => {
   window.addEventListener("error", suppressExpectedError);
   sessionStorage.clear();
   reload.mockReset();
-  vi.stubGlobal("location", { reload });
+  copyText.mockClear();
+  vi.stubGlobal("location", { reload, pathname: "/c/abc" });
   vi.spyOn(navigator, "onLine", "get").mockReturnValue(true);
   vi.spyOn(console, "error").mockImplementation(() => {});
 });
@@ -102,6 +106,30 @@ describe("RenderErrorBoundary", () => {
     expect(screen.getByText("Panel recovered")).toBeInTheDocument();
   });
 
+  it("shows the error, component stack and path, with copy and reload", () => {
+    function BrokenChild(): never {
+      throw renderError;
+    }
+    render(
+      <RenderErrorBoundary name="this page">
+        <BrokenChild />
+      </RenderErrorBoundary>,
+    );
+
+    const alert = screen.getByRole("alert");
+    expect(alert).toHaveTextContent("Component render failed");
+    expect(alert).toHaveTextContent("BrokenChild");
+    expect(alert).toHaveTextContent("Path: /c/abc");
+    expect(screen.getByRole("button", { name: "Try again" })).toBeInTheDocument();
+
+    fireEvent.click(screen.getByRole("button", { name: "Copy details" }));
+    expect(copyText).toHaveBeenCalledWith(
+      expect.stringMatching(/Component render failed[\s\S]*BrokenChild[\s\S]*\/c\/abc/),
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Reload" }));
+    expect(reload).toHaveBeenCalledOnce();
+  });
+
   it("retries a failed child when the session changes", () => {
     function SessionPanel({ session }: { session: string }) {
       if (session === "session-a") throw renderError;
diff --git a/web/src/components/RenderErrorBoundary.tsx b/web/src/components/RenderErrorBoundary.tsx
index 618e66ba0500fe2e7a4079de28134b4d45538c5d..8220fcac9913a965ec4f20f59b7ff9c42f2c2244 100644
--- a/web/src/components/RenderErrorBoundary.tsx
+++ b/web/src/components/RenderErrorBoundary.tsx
@@ -1,6 +1,7 @@
 import { Component, type ErrorInfo, type ReactNode } from "react";
 import { Button } from "@/components/ui/button";
 import { isChunkLoadError } from "@/lib/chunkLoadRecovery";
+import { copyText } from "@/lib/clipboard";
 
 interface Props {
   children: ReactNode;
@@ -11,6 +12,8 @@ interface Props {
 interface State {
   failed: boolean;
   resetKey?: string;
+  error?: unknown;
+  componentStack?: string;
 }
 
 /** Contains render failures without remounting healthy content on navigation. */
@@ -24,25 +27,59 @@ export class RenderErrorBoundary extends Component<Props, State> {
   static getDerivedStateFromError(error: unknown) {
     // Let the app's chunk boundary keep its guarded reload recovery.
     if (isChunkLoadError(error)) throw error;
-    return { failed: true };
+    return { failed: true, error, componentStack: undefined };
   }
 
   override componentDidCatch(error: Error, info: ErrorInfo) {
     console.error(`Rendering ${this.props.name} failed`, error, info.componentStack);
+    this.setState({ componentStack: info.componentStack ?? undefined });
   }
 
   override render() {
     if (!this.state.failed) return this.props.children;
+    // What a bug report needs: the error, where React was rendering, and the page.
+    const details = [
+      describeError(this.state.error),
+      this.state.componentStack ? `Component stack:${this.state.componentStack}` : "",
+      `Path: ${location.pathname}`,
+    ]
+      .filter(Boolean)
+      .join("\n\n");
     return (
       <div
         role="alert"
         className="flex min-h-0 flex-1 flex-col items-center justify-center gap-3 p-6 text-center"
       >
         <p className="text-sm text-muted-foreground">Unable to display {this.props.name}.</p>
-        <Button type="button" variant="outline" onClick={() => this.setState({ failed: false })}>
-          Try again
-        </Button>
+        <div className="flex flex-wrap justify-center gap-2">
+          <Button type="button" variant="outline" onClick={() => this.setState({ failed: false })}>
+            Try again
+          </Button>
+          <Button type="button" variant="outline" onClick={() => location.reload()}>
+            Reload
+          </Button>
+          <Button
+            type="button"
+            variant="ghost"
+            onClick={() => void copyText(details).catch(() => {})}
+          >
+            Copy details
+          </Button>
+        </div>
+        <pre className="max-h-60 w-full max-w-3xl overflow-auto rounded-md bg-muted p-3 text-left font-mono text-xs whitespace-pre-wrap select-text">
+          {details}
+        </pre>
       </div>
     );
   }
 }
+
+function describeError(error: unknown): string {
+  if (error instanceof Error) return error.stack ?? `${error.name}: ${error.message}`;
+  try {
+    return String(error);
+  } catch {
+    // Objects without a prototype have no toString; the fallback must not throw.
+    return "Unknown error";
+  }
+}
