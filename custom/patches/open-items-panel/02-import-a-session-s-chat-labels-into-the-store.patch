+/** A chat item to store under its chat label; see `POST …/open-items/import`. */
+export interface ChatItemImport {
+  kind: OpenItemKind;
+  label: string;
+  title: string;
+  detail: string;
+  url?: string;
+  /** Stores it closed, for an item the chat closed or the user dismissed. */
