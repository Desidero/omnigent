+import { afterEach, describe, expect, it, vi } from "vitest";
+
+const fetchMock = vi.hoisted(() => vi.fn());
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: fetchMock }));
+
+import {
+  buildItemLabelIndex,
+  itemLabelsIn,
+  struckItemLabelsIn,
