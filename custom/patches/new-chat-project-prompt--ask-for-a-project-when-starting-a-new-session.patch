@@ -0,0 +1,24 @@
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY,
+  readNewChatProjectPromptEnabled,
+  writeNewChatProjectPromptEnabled,
+} from "./newChatProjectPromptPreferences";
+
+describe("newChatProjectPromptPreferences", () => {
+  afterEach(() => localStorage.clear());
+
+  it("defaults on when storage is unset", () => {
+    expect(readNewChatProjectPromptEnabled()).toBe(true);
+  });
+
+  it("persists an off preference and restores the default by clearing it", () => {
+    writeNewChatProjectPromptEnabled(false);
+    expect(localStorage.getItem(NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY)).toBe("off");
+    expect(readNewChatProjectPromptEnabled()).toBe(false);
+
+    writeNewChatProjectPromptEnabled(true);
+    expect(localStorage.getItem(NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY)).toBeNull();
+    expect(readNewChatProjectPromptEnabled()).toBe(true);
+  });
+});
diff --git a/web/src/lib/newChatProjectPromptPreferences.ts b/web/src/lib/newChatProjectPromptPreferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..31f7346e420d2527e45b3d4bc4c6185863d5af46
--- /dev/null
+++ b/web/src/lib/newChatProjectPromptPreferences.ts
@@ -0,0 +1,26 @@
+// App-global preference (Settings › General): when projects exist, starting a
+// new session first asks which project it belongs to. On unless turned off.
+
+export const NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY = "omnigent:new-chat-project-prompt";
+
+export function readNewChatProjectPromptEnabled(): boolean {
+  if (typeof window === "undefined") return true;
+  try {
+    return window.localStorage.getItem(NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY) !== "off";
+  } catch {
+    return true;
+  }
+}
+
+export function writeNewChatProjectPromptEnabled(enabled: boolean): void {
+  if (typeof window === "undefined") return;
+  try {
+    if (enabled) {
+      window.localStorage.removeItem(NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY);
+    } else {
+      window.localStorage.setItem(NEW_CHAT_PROJECT_PROMPT_STORAGE_KEY, "off");
+    }
+  } catch {
+    // localStorage failures should not make Settings unusable.
+  }
+}
