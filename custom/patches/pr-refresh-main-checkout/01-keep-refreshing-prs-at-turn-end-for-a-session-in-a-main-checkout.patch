From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FeiyangP <feiyangpeng532@gmail.com>
Date: Fri, 20 Nov 2026 00:02:57 +0000
Subject: [PATCH] fix(server): keep refreshing PRs at turn end for a session in
 a main checkout

A turn-end PR refresh returned early for a session with no git branch
whose synced PR list was empty, taking that to mean the workspace is not a
git checkout. But a session started in a repository's main checkout, not
in a worktree, has no git branch either. Once its first refresh came back
empty, a PR opened later from the GitHub web UI or another terminal did
not show up until someone opened the Pull Requests panel.

Ask the runner or host at every turn end instead. The cost is one host
call per turn end for a workspace that is not a git checkout.

Carried from upstream pull request
https://github.com/omnigent-ai/omnigent/pull/14515 by FeiyangP (commit
83d9fb895c), which closes
https://github.com/omnigent-ai/omnigent/issues/12844. The source change is
the pull request's as written; its test is placed after the one that
https://github.com/omnigent-ai/omnigent/pull/14933 added at the same spot.

Not upstream yet: open as https://github.com/omnigent-ai/omnigent/pull/14515;
drop this copy once it merges.

Signed-off-by: FeiyangP <feiyangpeng532@gmail.com>
Signed-off-by: Desidero <desidero@gmail.com>
Docs: none (fix; the pull request adds no docs)
---
 .../routes/sessions/routes_resources.py       | 10 +----
 tests/server/routes/test_session_resources.py | 41 +++++++++++++++++++
 2 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/omnigent/server/routes/sessions/routes_resources.py b/omnigent/server/routes/sessions/routes_resources.py
index 4c257887c87a5716cc84a7d294d8722390ef21b9..27f7ce6b761bf927d83492edccbd9c67f2fd39ff 100644
--- a/omnigent/server/routes/sessions/routes_resources.py
+++ b/omnigent/server/routes/sessions/routes_resources.py
@@ -3934,14 +3934,8 @@ def register_resources_routes(
         conv = await _validate_session(session_id)
         if not _tunnel_is_local(conv):
             return
-        stored = (
-            await asyncio.to_thread(pull_request_store.read, session_id)
-            if pull_request_store is not None
-            else None
-        )
-        # Outside a git checkout, a synced session without PRs has none to refresh.
-        if conv.git_branch is None and stored is not None and stored.synced and not stored.entries:
-            return
+        # Ask even when the synced list is empty: a session in a repository's main
+        # checkout has no git_branch, and its PR may be opened after the last sync.
         await _github_info(session_id, conv)
 
     if pull_request_refresher is not None and pull_request_store is not None:
diff --git a/tests/server/routes/test_session_resources.py b/tests/server/routes/test_session_resources.py
index 6fa42890e73ebae130e494f472cd77a462ada595..6d77baf80b73b07c079b3493d7137360768256e4 100644
--- a/tests/server/routes/test_session_resources.py
+++ b/tests/server/routes/test_session_resources.py
@@ -3907,6 +3907,47 @@ async def test_background_pr_refreshes_and_plain_reads_ask_the_runner_for_a_fres
     assert all("allow_cached" not in params for params in github_reads)
 
 
+@pytest.mark.asyncio
+async def test_a_main_checkout_session_synced_without_prs_keeps_refreshing(
+    runner_globals_reset: None, db_uri: str
+) -> None:
+    """A session with no git branch of its own still picks up a PR opened later."""
+    from omnigent.server.session_pull_requests import PullRequestRefresher
+
+    del runner_globals_reset
+    SqlAlchemyConversationStore(db_uri).create_conversation(conversation_id=_PR_SESSION)
+    conversation_store = _ConversationStore()
+    conversation_store.storage_location = db_uri  # type: ignore[attr-defined]
+    conversation = conversation_store._conversations[_PR_SESSION]
+    conversation.runner_id = "runner_pr"
+    assert conversation.git_branch is None
+    refresher = PullRequestRefresher(turn_end_delay_s=0)
+    app = _sessions_app(conversation_store, pull_request_refresher=refresher)
+    runner = _FakeRunnerClient(
+        payload={"object": "session.github.info", "tracking_available": True, "prs": []}
+    )
+    set_runner_router(_OnlineRunnerRouter(runner))  # type: ignore[arg-type]
+    listed = f"/v1/sessions/{_PR_SESSION}/pull-requests"
+    async with httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app), base_url="http://server"
+    ) as client:
+        await _end_turn(refresher, _PR_SESSION)
+        empty = (await client.get(listed)).json()
+        runner._payload = _pr_info()
+        await _end_turn(refresher, _PR_SESSION)
+        after = (await client.get(listed)).json()
+    assert (empty["data"], empty["synced"]) == ([], True)
+    assert [pr["url"] for pr in after["data"]] == [_FIRST_PR, _SECOND_PR]
+
+
+async def _end_turn(refresher: Any, session_id: str) -> None:
+    """End a turn and wait for the PR refresh it schedules."""
+    refresher.turn_ended(session_id)
+    await asyncio.sleep(0)
+    while refresher._running:
+        await asyncio.gather(*refresher._running.values())
+
+
 @pytest.mark.asyncio
 async def test_pull_request_list_pages_by_url(pr_client: httpx.AsyncClient) -> None:
     set_runner_router(_FakeRunnerRouter(_FakeRunnerClient(payload=_pr_info())))  # type: ignore[arg-type]
