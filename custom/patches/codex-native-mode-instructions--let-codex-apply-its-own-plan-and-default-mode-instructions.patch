From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Desidero <desidero@gmail.com>
Date: Tue, 20 Oct 2026 14:57:38 -0500
Subject: [PATCH] fix(codex-native): let Codex apply its own Plan and Default
 mode instructions

Starting a Default-mode implementation turn sent the configured
developer_instructions as the collaboration mode's developer_instructions.
Codex's app-server treats that field as the mode's instructions: a null is
filled with the built-in Default preset (normalize_collaboration_mode,
present since 0.129), and any value replaces it. The configured
developer_instructions are a separate session setting that this update
never touches, so echoing them dropped the Default preset for every agent
with authored instructions and repeated the authored text in the mode
section.

Send null from _default_collaboration_mode so Codex applies its preset;
authored instructions keep reaching Codex through config.toml. The Plan
toggle in native_controls already does this upstream
(https://github.com/omnigent-ai/omnigent/pull/11570), so only the forwarder
half is carried here.

Not upstream yet: proposed from fix/codex-native-default-mode-instructions; drop this copy once it merges.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Desidero <desidero@gmail.com>
Docs: none (fix: Codex keeps its built-in Default mode instructions; no setting)
---
 omnigent/harnesses/codex_native/forwarder.py     |  4 +++-
 .../codex_native/forwarder/test_instructions.py  | 16 +++++++---------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/omnigent/harnesses/codex_native/forwarder.py b/omnigent/harnesses/codex_native/forwarder.py
index ebe9e3751922d12dd30c75c5bb0494a30a5e1ab9..c9995c6601ff08c905ccebacb6e2e7bb7f633f62 100644
--- a/omnigent/harnesses/codex_native/forwarder.py
+++ b/omnigent/harnesses/codex_native/forwarder.py
@@ -6158,7 +6158,9 @@ def _default_collaboration_mode(
         "settings": {
             "model": forwarder_state.model,
             "reasoning_effort": None,
-            "developer_instructions": forwarder_state.developer_instructions,
+            # None selects Codex's built-in mode instructions; a value would replace
+            # them. Configured developer_instructions reach Codex separately.
+            "developer_instructions": None,
         },
     }
 
diff --git a/tests/harnesses/codex_native/forwarder/test_instructions.py b/tests/harnesses/codex_native/forwarder/test_instructions.py
index 01a9c30936d068720befd6db0dc17262bae61039..fda6e6e39f216c089cef6fa1417121bfeaf80061 100644
--- a/tests/harnesses/codex_native/forwarder/test_instructions.py
+++ b/tests/harnesses/codex_native/forwarder/test_instructions.py
@@ -50,14 +50,12 @@ def test_default_collaboration_mode_sends_none_when_confirmed_absent() -> None:
     assert mode["settings"]["developer_instructions"] is None
 
 
-def test_default_collaboration_mode_reuses_current_developer_instructions() -> None:
-    """A Default-mode ``turn/start`` must not silently wipe developer_instructions.
-
-    Guards a self-inflicted overwrite: a ``_default_collaboration_mode`` that
-    always sends ``developer_instructions: null`` has that null applied
-    literally by Codex's app-server, clearing whatever
-    ``build_codex_native_server`` persisted, the instant the user (or the
-    plan-implementation flow) triggers a Default-mode turn.
+def test_default_collaboration_mode_keeps_codex_mode_instructions() -> None:
+    """A Default-mode ``turn/start`` never replaces Codex's built-in mode instructions.
+
+    Codex's app-server fills a null ``collaborationMode`` instruction with the
+    mode's preset; configured ``developer_instructions`` apply separately, so
+    echoing them here would only drop the preset.
     """
     state = fwd._CodexForwarderState()
     state.model = "gpt-5.4"
@@ -67,7 +65,7 @@ def test_default_collaboration_mode_reuses_current_developer_instructions() -> N
     mode = fwd._default_collaboration_mode(state)
 
     assert mode is not None
-    assert mode["settings"]["developer_instructions"] == "Be a concise coding assistant."
+    assert mode["settings"]["developer_instructions"] is None
 
 
 def test_note_thread_settings_updated_whitespace_nested_value_not_confirmed() -> None:
