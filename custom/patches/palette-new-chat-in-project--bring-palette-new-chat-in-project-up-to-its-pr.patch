diff --git a/web/src/shell/CommandPalette.test.tsx b/web/src/shell/CommandPalette.test.tsx
index 5a2f75dd707f3208a1b505b980c58c2f8c70a10a..61fe7f4e0c273fa20272e1bad6422e52755d4bb4 100644
--- a/web/src/shell/CommandPalette.test.tsx
+++ b/web/src/shell/CommandPalette.test.tsx
@@ -412,6 +412,24 @@ describe("CommandPalette — new chat in project", () => {
     expect(screen.getByTestId("project-icon").textContent).toBe("🔥");
   });
 
+  it("lists every project when the query is the group heading's word", () => {
+    renderPalette();
+    fireEvent.change(screen.getByTestId("command-palette-input"), {
+      target: { value: "project" },
+    });
+    expect(screen.getByText("New chat in omnigent")).toBeTruthy();
+    expect(screen.getByText("New chat in home lab")).toBeTruthy();
+  });
+
+  it("opens the highlighted project row with Enter", () => {
+    const { onOpenChange } = renderPalette();
+    const input = screen.getByTestId("command-palette-input");
+    fireEvent.change(input, { target: { value: "omni" } });
+    fireEvent.keyDown(input, { key: "Enter" });
+    expect(navigate).toHaveBeenCalledWith("/?project=omnigent");
+    expect(onOpenChange).toHaveBeenCalledWith(false);
+  });
+
   it("opens the composer with the project's defaults and closes", () => {
     const { onOpenChange } = renderPalette();
     fireEvent.change(screen.getByTestId("command-palette-input"), {
diff --git a/web/src/shell/CommandPalette.tsx b/web/src/shell/CommandPalette.tsx
index 14b6ee83888a8c761bf7363dddbafa434829b39b..c9c976d935207fd863829c402bafcf6d3d6ded14 100644
