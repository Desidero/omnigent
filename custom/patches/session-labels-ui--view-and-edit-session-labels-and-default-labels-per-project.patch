diff --git a/web/src/components/composer/NewSessionLabels.tsx b/web/src/components/composer/NewSessionLabels.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..e6cbe4a7b483f1734a5106dbf9ce4a094c01eb58
--- /dev/null
