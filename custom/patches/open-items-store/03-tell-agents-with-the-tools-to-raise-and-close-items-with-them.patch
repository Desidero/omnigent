diff --git a/omnigent/runtime/prompt.py b/omnigent/runtime/prompt.py
index a99a3f3a786ea052ba07cf95a9e36ebaab34facd..64c61ed5c3ccc5febee22c1c416bb9e50b47f028 100644
--- a/omnigent/runtime/prompt.py
