+    assert _labels(results) == ["Q1", "Q2", "Q3", "session_full"]
+    monkeypatch.setattr(open_items_store, "ITEMS_PER_SESSION", 500)
+    monkeypatch.setattr(open_items_store, "NUMBER_MAX", 4)
