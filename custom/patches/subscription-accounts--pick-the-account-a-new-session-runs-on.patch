+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { DropdownMenu, DropdownMenuContent } from "@/components/ui/dropdown-menu";
+import type { HostProvider } from "@/hooks/useHostProviders";
+import {
+  buildAccountSection,
+  currentProvider,
+  inPlaceSwitchBlocked,
+  SEPARATE_LOGIN_HINT,
+} from "./accountSection";
+import { ComposerConfigSections, type ComposerConfigSection } from "./ComposerConfigSections";
+
+afterEach(cleanup);
+
+const MAX1: HostProvider = {
+  name: "claude-max1",
+  kind: "subscription",
+  label: "claude CLI login (~/.claude-max1)",
+  default: true,
+  ready: true,
+  switch_group: "claude-accounts",
+};
+const MAX2: HostProvider = {
+  ...MAX1,
+  name: "claude-max2",
+  label: "claude CLI login (~/.claude-max2)",
+  default: false,
+};
+// Older hosts omit switch_group entirely.
+const DBX: HostProvider = {
+  name: "databricks",
+  kind: "databricks",
+  label: "Databricks profile alt",
+  default: false,
+  ready: true,
+};
+
+function renderSection(section: ComposerConfigSection | undefined) {
+  return render(
+    <DropdownMenu open>
+      <DropdownMenuContent>
+        <ComposerConfigSections extra={section ? [section] : []} />
+      </DropdownMenuContent>
+    </DropdownMenu>,
+  );
+}
+
+describe("buildAccountSection", () => {
+  it("is omitted without a real choice", () => {
+    expect(
+      buildAccountSection({ providers: [MAX1], value: null, testIdPrefix: "t", onSelect: vi.fn() }),
+    ).toBeUndefined();
+  });
+
+  it("checks the default and maps picks to a name, or null for the default", () => {
+    const onSelect = vi.fn();
+    renderSection(
+      buildAccountSection({
+        providers: [MAX2, MAX1, DBX],
+        value: null,
+        testIdPrefix: "t",
+        onSelect,
+      }),
+    );
+
+    expect(screen.getByTestId("t-accounts")).toHaveTextContent(/^Account/);
+    const first = screen.getAllByRole("menuitemcheckbox")[0];
+    expect(first).toHaveTextContent("Default (claude-max1)");
+    expect(first).toHaveAttribute("aria-checked", "true");
+    fireEvent.click(screen.getByTestId("t-account-claude-max2"));
+    expect(onSelect).toHaveBeenLastCalledWith("claude-max2");
+  });
+
+  it("sends null when going back to the default", () => {
+    const onSelect = vi.fn();
+    renderSection(
+      buildAccountSection({
+        providers: [MAX1, MAX2],
+        value: "claude-max2",
+        testIdPrefix: "t",
+        onSelect,
+      }),
+    );
+
+    expect(screen.getByTestId("t-account-claude-max2")).toHaveAttribute("aria-checked", "true");
+    fireEvent.click(screen.getByTestId("t-account-claude-max1"));
+    expect(onSelect).toHaveBeenLastCalledWith(null);
+  });
+
+  it("disables an account that is not signed in", () => {
+    renderSection(
+      buildAccountSection({
+        providers: [MAX1, { ...MAX2, ready: false }],
+        value: null,
+        testIdPrefix: "t",
+        onSelect: vi.fn(),
+      }),
+    );
+
+    const option = screen.getByTestId("t-account-claude-max2");
+    expect(option).toHaveAttribute("data-disabled");
+    expect(option).toHaveTextContent("not signed in");
+  });
+});
+
+describe("inPlaceSwitchBlocked", () => {
+  it("allows only the running account's switch group", () => {
+    const current = currentProvider([MAX1, MAX2, DBX], null);
+    expect(current).toBe(MAX1);
+    expect(inPlaceSwitchBlocked(MAX1, current)).toBeUndefined();
+    expect(inPlaceSwitchBlocked(MAX2, current)).toBeUndefined();
+    expect(inPlaceSwitchBlocked(DBX, current)).toBe(SEPARATE_LOGIN_HINT);
+    expect(inPlaceSwitchBlocked({ ...MAX2, switch_group: "other" }, current)).toBe(
+      SEPARATE_LOGIN_HINT,
+    );
+  });
+
+  it("blocks every other account when the running one has no group", () => {
+    const current = currentProvider([MAX1, MAX2, DBX], "databricks");
+    expect(inPlaceSwitchBlocked(MAX1, current)).toBe(SEPARATE_LOGIN_HINT);
+    expect(inPlaceSwitchBlocked(DBX, current)).toBeUndefined();
+  });
+});
diff --git a/web/src/components/composer/accountSection.tsx b/web/src/components/composer/accountSection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4643ed7b0bcc8ee8699163e01ea6eb3af6304586
--- /dev/null
+++ b/web/src/components/composer/accountSection.tsx
@@ -0,0 +1,89 @@
+/**
+ * Build the "Account" section of the harness menu: which of the host's
+ * providers (e.g. one of several Claude subscriptions) a session runs on.
+ *
+ * Shared by the new-session dialog (picks the account a session starts on) and
+ * the in-session composer (switches a running session), so both list the same
+ * rows, labels and disabled states.
+ */
+import type { HostProvider } from "@/hooks/useHostProviders";
+import type { ComposerConfigSection } from "./ComposerConfigSections";
+
+export const SEPARATE_LOGIN_HINT = "Separate login — start a new session";
+
+/** The provider a session runs on: its override, else the host default. */
+export function currentProvider(
+  providers: readonly HostProvider[],
+  override: string | null | undefined,
+): HostProvider | undefined {
+  return override != null
+    ? providers.find((p) => p.name === override)
+    : providers.find((p) => p.default);
+}
+
+/**
+ * Why a running session can't move onto `provider` in place, or `undefined`
+ * when it can. Only providers sharing the current one's switch group share a
+ * login and conversation store.
+ */
+export function inPlaceSwitchBlocked(
+  provider: HostProvider,
+  current: HostProvider | undefined,
+): string | undefined {
+  if (provider === current) return undefined;
+  const group = current?.switch_group ?? null;
+  return group !== null && provider.switch_group === group ? undefined : SEPARATE_LOGIN_HINT;
+}
+
+export function buildAccountSection({
+  providers,
+  value,
+  testIdPrefix,
+  onSelect,
+  disabled = false,
+  blockedReason,
+}: {
+  providers: readonly HostProvider[];
+  /** The chosen provider name; `null` = the host default. */
+  value: string | null;
+  /** e.g. `new-chat-landing-agent` or `composer-agent`. */
+  testIdPrefix: string;
+  /** Called with the picked provider name, or `null` for the host default. */
+  onSelect: (name: string | null) => void;
+  disabled?: boolean;
+  /** Extra reason a ready row can't be picked (shown as its hint). */
+  blockedReason?: (provider: HostProvider) => string | undefined;
+}): ComposerConfigSection | undefined {
+  if (providers.length < 2) return undefined;
+  const selected = currentProvider(providers, value);
+  const ordered = [...providers.filter((p) => p.default), ...providers.filter((p) => !p.default)];
+  return {
+    testId: `${testIdPrefix}-accounts`,
+    header: "Account",
+    choices: ordered.map((provider) => {
+      const checked = provider === selected;
+      const blocked = provider.ready ? blockedReason?.(provider) : undefined;
+      const hint = !provider.ready
+        ? `${provider.label} · not signed in`
+        : (blocked ?? provider.label);
+      return {
+        key: provider.name,
+        label: (
+          <span className="flex min-w-0 flex-col">
+            <span className="truncate">
+              {provider.default ? `Default (${provider.name})` : provider.name}
+            </span>
+            <span className="truncate text-xs text-muted-foreground">{hint}</span>
+          </span>
+        ),
+        checked,
+        disabled: disabled || !provider.ready || blocked !== undefined,
+        onSelect: checked ? undefined : () => onSelect(provider.default ? null : provider.name),
+        testId: `${testIdPrefix}-account-${provider.name}`,
+        title: blocked ? `${provider.label} · ${blocked}` : hint,
+        className: "whitespace-normal [&>span:last-child]:min-w-0",
+        data: { "data-provider": provider.name },
+      };
+    }),
+  };
+}
