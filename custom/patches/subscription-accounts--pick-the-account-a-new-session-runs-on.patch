+import { describe, expect, it } from "vitest";
+import type { HostProvider } from "@/hooks/useHostProviders";
+import { resolveSessionProvider } from "./sessionProvider";
+
+const MAX1: HostProvider = {
+  name: "max1",
+  kind: "subscription",
+  label: "a",
+  default: true,
+  ready: true,
+};
+const MAX2: HostProvider = { ...MAX1, name: "max2", label: "b", default: false };
+
+const base = { userPick: undefined, projectProvider: undefined, accountsApply: true };
+
+describe("resolveSessionProvider", () => {
+  it("runs on the host default with no pick and no project account", () => {
+    expect(resolveSessionProvider({ ...base, providers: [MAX1, MAX2] })).toEqual({
+      override: null,
+      projectFallback: null,
+    });
+  });
+
+  it("uses the project's account when the host lists it", () => {
+    expect(
+      resolveSessionProvider({ ...base, projectProvider: "max2", providers: [MAX1, MAX2] }),
+    ).toEqual({ override: "max2", projectFallback: null });
+  });
+
+  it("sends no override when the project's account is the host default", () => {
+    expect(
+      resolveSessionProvider({ ...base, projectProvider: "max1", providers: [MAX1, MAX2] }),
+    ).toEqual({ override: null, projectFallback: null });
+  });
+
+  it("lets the user's pick win over the project's account", () => {
+    expect(
+      resolveSessionProvider({
+        ...base,
+        userPick: null,
+        projectProvider: "max2",
+        providers: [MAX1, MAX2],
+      }),
+    ).toEqual({ override: null, projectFallback: null });
+  });
+
+  it("falls back with a reason when the host can't run the harness on it", () => {
+    const choice = resolveSessionProvider({
+      ...base,
+      projectProvider: "codex-alt",
+      providers: [MAX1, MAX2],
+    });
+    expect(choice.override).toBeNull();
+    expect(choice.projectFallback).toMatch(/"codex-alt" isn't available for this harness/);
+  });
+
+  it("falls back with a reason when the account is not signed in", () => {
+    const choice = resolveSessionProvider({
+      ...base,
+      projectProvider: "max2",
+      providers: [MAX1, { ...MAX2, ready: false }],
+    });
+    expect(choice.override).toBeNull();
+    expect(choice.projectFallback).toMatch(/isn't signed in/);
+  });
+
+  it("sends the project's account while the list loads, for the host to check", () => {
+    expect(
+      resolveSessionProvider({ ...base, projectProvider: "max2", providers: undefined }),
+    ).toEqual({ override: "max2", projectFallback: null });
+  });
+
+  it("says so when accounts don't apply to the session", () => {
+    const choice = resolveSessionProvider({
+      ...base,
+      projectProvider: "max2",
+      providers: undefined,
+      accountsApply: false,
+    });
+    expect(choice.override).toBeNull();
+    expect(choice.projectFallback).toMatch(/doesn't apply to sandbox or routed sessions/);
+  });
+});
diff --git a/web/src/lib/sessionProvider.ts b/web/src/lib/sessionProvider.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa77a81add58d561bad0df8e369c7d7c1899b8a9
--- /dev/null
+++ b/web/src/lib/sessionProvider.ts
@@ -0,0 +1,61 @@
+import type { HostProvider } from "@/hooks/useHostProviders";
+
+export interface SessionProviderChoice {
+  /** `provider_override` to send; `null` runs on the host's default. */
+  override: string | null;
+  /** Why the project's default account is not used, shown under the composer. */
+  projectFallback: string | null;
+}
+
+/**
+ * Resolve the account a new session runs on. The user's pick wins; otherwise a
+ * project's default account applies where the host can run the harness on it,
+ * and falls back to the host default with a visible reason where it can't.
+ */
+export function resolveSessionProvider({
+  userPick,
+  projectProvider,
+  providers,
+  accountsApply,
+}: {
+  /** `undefined` = no pick yet; `null` = the user picked the host default. */
+  userPick: string | null | undefined;
+  /** The project's stored `provider`, if any. */
+  projectProvider: string | undefined;
+  /** The host's providers for the harness; `undefined` until listed. */
+  providers: HostProvider[] | undefined;
+  /** False for a sandbox or a routed harness, where host accounts don't apply. */
+  accountsApply: boolean;
+}): SessionProviderChoice {
+  const project = userPick === undefined ? projectProvider?.trim() || null : null;
+  if (!accountsApply) {
+    return {
+      override: null,
+      projectFallback: project
+        ? `Project account "${project}" doesn't apply to sandbox or routed sessions; using the default account.`
+        : null,
+    };
+  }
+  if (userPick !== undefined) {
+    // A pick from another host or harness family no longer applies.
+    const valid = providers?.some((p) => p.name === userPick && !p.default) ?? false;
+    return { override: valid ? userPick : null, projectFallback: null };
+  }
+  if (project === null) return { override: null, projectFallback: null };
+  // Not listed yet: send the project's account and let the host reject it loudly.
+  if (providers === undefined) return { override: project, projectFallback: null };
+  const match = providers.find((p) => p.name === project);
+  if (!match) {
+    return {
+      override: null,
+      projectFallback: `Project account "${project}" isn't available for this harness on this host; using the default account.`,
+    };
+  }
+  if (!match.ready) {
+    return {
+      override: null,
+      projectFallback: `Project account "${project}" isn't signed in on this host; using the default account.`,
+    };
+  }
+  return { override: match.default ? null : match.name, projectFallback: null };
+}
