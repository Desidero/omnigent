 web/src/shell/CommandPalette.tsx         | 17 +++-
 5 files changed, 137 insertions(+), 32 deletions(-)

diff --git a/web/src/hooks/useNewChatProjectPrompt.ts b/web/src/hooks/useNewChatProjectPrompt.ts
index fe3b25a9a2cfa682651404d9daac5aa4a42a8982..76e9364623e4a6b759da58725766cec3630fc15f 100644
--- a/web/src/hooks/useNewChatProjectPrompt.ts
+++ b/web/src/hooks/useNewChatProjectPrompt.ts
@@ -5,11 +5,13 @@ import { readNewChatProjectPromptEnabled } from "@/lib/newChatProjectPromptPrefe
 
 /**
  * Returns a check for whether starting a new session should first ask for a
- * project: at least one project exists and the prompt isn't turned off in
- * Settings. The preference is read at call time so a toggle applies at once.
+ * project: the project list may hold one and the prompt isn't turned off in
+ * Settings. Until the list resolves it counts as "may": the picker lists
+ * projects as they arrive and steps aside if none do (see `CommandPalette`).
+ * The preference is read at call time so a toggle applies at once.
  */
 export function useShouldPromptForProject(): () => boolean {
-  const { data: projects = [] } = useProjects();
-  const hasProjects = projects.length > 0;
-  return useCallback(() => hasProjects && readNewChatProjectPromptEnabled(), [hasProjects]);
+  const { data: projects } = useProjects();
+  const mayHaveProjects = projects === undefined || projects.length > 0;
+  return useCallback(() => mayHaveProjects && readNewChatProjectPromptEnabled(), [mayHaveProjects]);
 }
