+                        "host": {
+                            "type": "string",
+                            "description": "add/update, git kind: the bare host name.",
+                        },
+                        "enabled": {
+                            "type": "boolean",
+                            "description": "add/update: whether chat messages use the rule.",
+                        },
+                    },
+                    "required": ["action"],
+                    "additionalProperties": False,
+                },
+            },
+        }
