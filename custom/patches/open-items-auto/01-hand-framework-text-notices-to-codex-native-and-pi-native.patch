 def framework_notices(content: object) -> list[str]:
     """Extract transient framework notices from structured content."""
     if not isinstance(content, list):
@@ -609,12 +614,31 @@ def framework_notices(content: object) -> list[str]:
     for block in content:
         if not isinstance(block, dict) or block.get("type") != FRAMEWORK_NOTICE_BLOCK_TYPE:
             continue
-        text = resize_notice(block.get("source_metadata"))
+        text = block.get("text")
+        if not isinstance(text, str):
+            text = resize_notice(block.get("source_metadata"))
         if text:
             notices.append(text)
     return notices
 
 
+def is_framework_text_notice(block: object) -> bool:
+    """Whether *block* is a framework notice carrying framework-owned text."""
+    return (
+        isinstance(block, dict)
+        and block.get("type") == FRAMEWORK_NOTICE_BLOCK_TYPE
+        and isinstance(block.get("text"), str)
+        and bool(block["text"])
+    )
+
+
+def framework_text_notices(content: object) -> list[str]:
+    """The framework-owned text notices in structured content, without upload notices."""
+    if not isinstance(content, list):
+        return []
+    return [block["text"] for block in content if is_framework_text_notice(block)]
+
