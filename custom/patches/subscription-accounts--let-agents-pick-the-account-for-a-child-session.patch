diff --git a/omnigent/onboarding/subscription_accounts.py b/omnigent/onboarding/subscription_accounts.py
index c045f621c731bad34f2bd3bbc5d17281a9bcb6d4..3ea46fabff7fc0d347437ed249a48964cd231f1b 100644
--- a/omnigent/onboarding/subscription_accounts.py
