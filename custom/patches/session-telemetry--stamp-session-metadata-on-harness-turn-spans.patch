+def _client(
+    handler: Callable[[httpx.Request], httpx.Response | Awaitable[httpx.Response]],
+) -> httpx.AsyncClient:
+    return httpx.AsyncClient(transport=httpx.MockTransport(handler), base_url="http://server")
+
