index 0000000000000000000000000000000000000000..008e597cf3978a43200a7e04b6d38d03ea42f83a
--- /dev/null
+++ b/web/src/hooks/useSandboxConnectionBlocks.test.tsx
@@ -0,0 +1,116 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { renderHook, waitFor } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { FALLBACK_SERVER_INFO, type ServerInfo } from "@/lib/capabilities";
+import { authenticatedFetch } from "@/lib/identity";
+import {
+  sandboxConnectionBlockMessage,
+  useSandboxConnectionBlocks,
+} from "./useSandboxConnectionBlocks";
+
+vi.mock("@/lib/identity", () => ({ authenticatedFetch: vi.fn() }));
+
+const fetchMock = vi.mocked(authenticatedFetch);
+
+function info(overrides: Partial<ServerInfo>): ServerInfo {
+  return {
+    ...FALLBACK_SERVER_INFO,
+    sandbox_provider_owner_connections: { databricks: "databricks" },
+    enabled_connections: ["databricks"],
+    ...overrides,
+  };
+}
+
+function respond(status: number, body: unknown) {
+  fetchMock.mockResolvedValue({
+    ok: status < 400,
+    status,
+    json: async () => body,
+  } as unknown as Response);
+}
+
+function renderBlocks(serverInfo: ServerInfo | "loading") {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <QueryClientProvider client={client}>{children}</QueryClientProvider>
+  );
+  const hook = renderHook(() => useSandboxConnectionBlocks(serverInfo, "alice"), { wrapper });
+  return { ...hook, client };
+}
+
+beforeEach(() => fetchMock.mockReset());
+
+describe("useSandboxConnectionBlocks", () => {
+  it("blocks a provider whose owner has not connected, with a way to connect", async () => {
+    respond(200, { enabled: true, connected: false });
+    const { result } = renderBlocks(info({}));
+    await waitFor(() =>
+      expect([...result.current]).toEqual([
+        ["databricks", { connection: "databricks", canConnect: true }],
+      ]),
+    );
+    expect(fetchMock).toHaveBeenCalledWith("/v1/connections/databricks/status");
+  });
+
+  it("blocks nothing once the owner is connected", async () => {
+    respond(200, { enabled: true, connected: true });
+    const { result } = renderBlocks(info({}));
+    await waitFor(() => expect(fetchMock).toHaveBeenCalled());
+    await waitFor(() => expect(result.current.size).toBe(0));
+  });
+
+  it.each([
+    ["the status request fails", 500, {}],
+    ["the status has no connected flag", 200, { enabled: true }],
+  ])("blocks nothing when %s, leaving the refusal to the server", async (_case, status, body) => {
+    respond(status, body);
+    const { result, client } = renderBlocks(info({}));
+    await waitFor(() => expect(fetchMock).toHaveBeenCalled());
+    await waitFor(() => expect(client.isFetching()).toBe(0));
+    expect(result.current.size).toBe(0);
+  });
+
+  it("blocks a provider without asking when the server has no such connection", () => {
+    const { result } = renderBlocks(info({ enabled_connections: ["github"] }));
+    expect([...result.current]).toEqual([
+      ["databricks", { connection: "databricks", canConnect: false }],
+    ]);
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    ["no provider launches as its owner", info({ sandbox_provider_owner_connections: {} })],
+    ["server info is still loading", "loading" as const],
+  ])("asks nothing and blocks nothing when %s", (_case, serverInfo) => {
+    const { result } = renderBlocks(serverInfo);
+    expect(result.current.size).toBe(0);
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("keeps the same map while the answer is unchanged", async () => {
+    respond(200, { enabled: true, connected: false });
+    const { result, rerender } = renderBlocks(info({}));
+    await waitFor(() => expect(result.current.size).toBe(1));
+    const first = result.current;
+    rerender();
+    expect(result.current).toBe(first);
+  });
+});
+
+describe("sandboxConnectionBlockMessage", () => {
+  it("names the account to connect or says the server has none", () => {
+    expect(
+      sandboxConnectionBlockMessage("Databricks Sandbox", {
+        connection: "databricks",
+        canConnect: true,
+      }),
+    ).toBe("Connect Databricks to use Databricks Sandbox");
+    expect(
+      sandboxConnectionBlockMessage("Databricks Sandbox", {
+        connection: "databricks",
+        canConnect: false,
+      }),
+    ).toBe("Databricks Sandbox is unavailable: this server has no Databricks connection set up");
+  });
+});
diff --git a/web/src/hooks/useSandboxConnectionBlocks.ts b/web/src/hooks/useSandboxConnectionBlocks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..da3831132bb17d6f60ac086eeb094b0cd78bee03
--- /dev/null
+++ b/web/src/hooks/useSandboxConnectionBlocks.ts
@@ -0,0 +1,70 @@
+import { useQueries } from "@tanstack/react-query";
+import { useMemo } from "react";
+import type { ServerInfo } from "@/lib/capabilities";
+import { getOmnigentServerIdentity } from "@/lib/host";
+import { authenticatedFetch } from "@/lib/identity";
+
+/** Why a sandbox provider cannot launch for the signed-in user. */
+export interface SandboxConnectionBlock {
+  /** The connection the provider launches as, e.g. ``"databricks"``. */
+  connection: string;
+  /** False when the server has no such connection set up, so the user cannot fix it. */
+  canConnect: boolean;
+}
+
+async function fetchConnected(connection: string): Promise<boolean | null> {
+  const response = await authenticatedFetch(
+    `/v1/connections/${encodeURIComponent(connection)}/status`,
+  );
+  if (!response.ok) throw new Error(`Connection status failed: ${response.status}`);
+  const body: unknown = await response.json();
+  const connected = (body as { connected?: unknown } | null)?.connected;
+  return typeof connected === "boolean" ? connected : null;
+}
+
+/**
+ * The sandbox providers the signed-in user cannot launch yet, keyed by provider.
+ *
+ * A provider that launches as its owner (``sandbox_provider_owner_connections``
+ * in ``/v1/info``) is blocked when the server has no such connection, or when
+ * the user's status says they have not connected. An unknown status (loading,
+ * failed) blocks nothing: the server refuses the launch either way.
+ */
+export function useSandboxConnectionBlocks(
+  info: ServerInfo | "loading",
+  user: string | null,
+): ReadonlyMap<string, SandboxConnectionBlock> {
+  const required = useMemo(
+    () => (info === "loading" ? [] : Object.entries(info.sandbox_provider_owner_connections ?? {})),
+    [info],
+  );
+  const offered = info === "loading" ? [] : info.enabled_connections;
+  const statuses = useQueries({
+    queries: required.map(([, connection]) => ({
+      queryKey: ["connection-status", user, connection, getOmnigentServerIdentity()] as const,
+      queryFn: () => fetchConnected(connection),
+      enabled: offered.includes(connection),
+    })),
+  });
+  const blockedKey = JSON.stringify(
+    required.flatMap(([provider, connection], index) => {
+      if (!offered.includes(connection)) return [[provider, { connection, canConnect: false }]];
+      return statuses[index]?.data === false ? [[provider, { connection, canConnect: true }]] : [];
+    }),
+  );
+  return useMemo(
+    () => new Map<string, SandboxConnectionBlock>(JSON.parse(blockedKey)),
+    [blockedKey],
+  );
+}
+
+/** What to tell the user about a blocked provider, e.g. for "Databricks Sandbox". */
+export function sandboxConnectionBlockMessage(
+  sandboxLabel: string,
+  block: SandboxConnectionBlock,
+): string {
+  const account = block.connection.charAt(0).toUpperCase() + block.connection.slice(1);
+  return block.canConnect
+    ? `Connect ${account} to use ${sandboxLabel}`
+    : `${sandboxLabel} is unavailable: this server has no ${account} connection set up`;
+}
