diff --git a/omnigent/server/pr_watch.py b/omnigent/server/pr_watch.py
new file mode 100644
index 0000000000000000000000000000000000000000..2da3d492b91db2ac6227a5493e045a7a52c48833
--- /dev/null
+++ b/omnigent/server/pr_watch.py
@@ -0,0 +1,1021 @@
+"""Keep a session on its pull requests until CI passes and review is clear.
+
+A session's owner opts in with ``PUT``/``PATCH /v1/sessions/{id}/pr-watch``,
+either for chosen pull requests or for every PR the session links now and later
+("all" mode). The server's stored list of the session's PRs decides which PRs
+those are; the runner's reports and the turn-end refresh keep it current, and
+the watcher asks for the listed-session refresh while "all" mode is on or the
+list is not imported yet.
+
+One :class:`PullRequestWatcher` per server reads every watched PR through the
+same path the Pull Requests panel uses (runner, else host, running the provider
+CLI with the host's credentials), so it needs no credentials of its own. When a
+check fails on the head commit, a repository owner, member or collaborator
+comments or reviews, or a PR stops merging cleanly, it sends the session one
+``[System: PR watch ...]`` message as its owner while the session is idle.
+Events that arrive during a turn wait for the next idle poll, which coalesces
+them, across PRs, into one message.
+
+Watch state lives in server-reserved session labels, so it survives a restart
+without a migration: :data:`MODE_LABEL_KEY` marks "all" mode, and each PR has
+a URL label and a state label keyed by a digest of its URL (see
+:func:`entry_label_keys`).
+
+A PR's watch ends with a short note in the session when it is green, merged or
+closed, when its wake-up budget is spent, when its CI checks cannot be read, or
+after repeated failures to deliver a wake-up. The ended watch stays recorded,
+so "all" mode does not pick the PR up again.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import hashlib
+import json
+import logging
+import os
+import re
+import time
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field, replace
+from typing import Any, Literal
